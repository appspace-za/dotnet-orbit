@page "/not-found"
@layout MainLayout
@* Shown when a page's load finds nothing (a NotFoundException, through NavigationManager.NotFound()). *@
<PageTitle>Not found - Orbit</PageTitle>
<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="my-4">
    <MudText Typo="Typo.h6" HtmlTag="h1">Not found</MudText>
    <MudText>There's nothing here. It may have been deleted, or the link is wrong.</MudText>
    <MudLink Href="/">Back to the dashboard</MudLink>
</MudAlert>
