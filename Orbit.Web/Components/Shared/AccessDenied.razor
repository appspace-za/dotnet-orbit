@* What a page shows when the signed-in user may not open it (a page door) or a service refused its load. *@
<PageTitle>Access denied - Orbit</PageTitle>
<MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="my-4">
    <MudText Typo="Typo.h6" HtmlTag="h1">Access denied</MudText>
    <MudText>@(Message ?? "You don't have permission to open this page.")</MudText>
    <MudLink Href="/">Back to the dashboard</MudLink>
</MudAlert>

@code {
    [Parameter] public string? Message { get; set; }
}
