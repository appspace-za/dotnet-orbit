@* One of a list page's filters (spec §6.2): a select of (value, text) options whose first is usually "All" (an empty value).
   Choosing one raises ValueChanged; the page puts the filter in the address and reloads. A list longer than SearchableAbove
   options is one you can type into (SearchSelect, §13 item 121). Its Special entries - "All", "None", "Me", "Backlog" - are
   listed first and kept at the top while typing; a page passes them apart from the ordinary Options, so nothing has to count
   them (§13 item 122). *@
@if (IsSearchable)
{
    <SearchSelect TValue="string" Value="@(Value ?? "")" ValueChanged="ValueChanged" Options="_pick" Pinned="_pinned" SelectedText="@Text(Value)"
                  Label="@Label" Title="@Title" Class="@Class" Margin="Margin.Dense" Dense="true" />
}
else
{
    <MudSelect T="string" Value="@(Value ?? "")" ValueChanged="ValueChanged" Label="@Label" ToStringFunc="Text" title="@Title"
               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="@Class">
        @foreach (var o in _all)
        {
            <MudSelectItem T="string" Value="@o.Value">@o.Text</MudSelectItem>
        }
    </MudSelect>
}

@code {
    /// <summary>A filter with more options than this can be searched by typing.</summary>
    public const int SearchableAbove = 10;

    /// <summary>The Special entries of a filter that can be "All" or "None" (the tasks on no project, nobody assigned).</summary>
    public static readonly IReadOnlyList<(string Value, string Text)> AllOrNone = [("", "All"), (FilterChoice.None, "None")];

    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    /// <summary>The ordinary options, listed after <see cref="Special"/>.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<(string Value, string Text)> Options { get; set; } = [];
    /// <summary>
    /// The special entries listed first ("All", "None", "Me", "Backlog"...), which stay at the top while typing. With none, an
    /// "All" (an empty value) leading <see cref="Options"/> stays at the top.
    /// </summary>
    [Parameter] public IReadOnlyList<(string Value, string Text)> Special { get; set; } = [];
    [Parameter] public string? Title { get; set; }
    [Parameter] public string Class { get; set; } = "orbit-filter";

    private IReadOnlyList<(string Value, string Text)>? _specialFrom, _optionsFrom;
    /// <summary>The special entries, then the ordinary options.</summary>
    private IReadOnlyList<(string Value, string Text)> _all = [];
    private IReadOnlyList<PickOption<string>> _pick = [];
    private int _pinned;

    private bool IsSearchable => _all.Count > SearchableAbove;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_specialFrom, Special) && ReferenceEquals(_optionsFrom, Options)) return;
        _specialFrom = Special;
        _optionsFrom = Options;
        _all = Special.Count == 0 ? Options : [.. Special, .. Options];
        _pinned = Special.Count > 0 ? Special.Count : Options.Count > 0 && Options[0].Value == "" ? 1 : 0;
        _pick = _all.Select(o => new PickOption<string>(o.Value, o.Text)).ToList();
    }

    private string Text(string? value) => _all.FirstOrDefault(o => o.Value == (value ?? "")).Text ?? value ?? "";

    /// <summary>"All" (empty), then an enum's values by name with their labels.</summary>
    public static IReadOnlyList<(string Value, string Text)> EnumOptions<T>(Func<T, string>? label = null) where T : struct, Enum =>
        [("", "All"), .. Enum.GetValues<T>().Select(v => (v.ToString(), label?.Invoke(v) ?? v.ToString()))];
}
