@page "/Tasks/My"
@inherits OrbitComponentBase
@* The My Tasks page became the Tasks list's My tasks filter (spec §6.2, decision 132). Its address stays so old links and bookmarks
   still work: it goes to the list filtered to the viewer's open tasks, replacing itself in the history so Back doesn't bounce. *@

@if (Refusal is not null)
{
    <AccessDenied Message="@Refusal" />
}
else
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}

@code {
    protected override async Task OnInitializedAsync()
    {
        Actor? actor = null;
        if (await Load(async s => actor = await s.Get<IActorProvider>().GetAsync()))
            Nav.NavigateTo(Navigation.MyTasks(actor!), replace: true);
    }
}
