@* Time utilisation (spec §12, decision 149): where the time logged in the period went. Four tiles; five charts (TimeUtilisationCharts, the
   same SVG as the PDF's: the time per day, week or month across the top, then by project beside by person and by task type beside
   by source); By person, the people who logged nothing greyed at the end; then By task, every task worked on, most time first,
   each opening on the people who logged time on it. ReportView keeps this component across runs (no @key), so the tasks opened
   stay open when a filter changes. *@

@{
    var s = Report.Summary;
    var maxPerson = Report.People.Count == 0 ? 0 : Report.People.Max(p => p.Minutes);
    var maxTask = Report.Tasks.Count == 0 ? 0 : Report.Tasks.Max(t => t.Minutes);
}
<div class="orbit-report-summary">
    <div class="orbit-stats">
        <MudPaper Outlined="true" Class="orbit-stat">
            <div class="orbit-stat-label">Logged</div>
            <div class="orbit-stat-value">@TimeFormat.Minutes(s.Minutes)</div>
            <div class="orbit-sub">on @Tasks(s.Tasks)</div>
        </MudPaper>
        <MudPaper Outlined="true" Class="orbit-stat">
            <div class="orbit-stat-label">People</div>
            <div class="orbit-stat-value">@s.People</div>
            @if (s.LoggedNothing > 0)
            {
                <div class="orbit-sub" title="Active people in the department reported on, listed greyed under By person">@s.LoggedNothing logged nothing</div>
            }
        </MudPaper>
        <MudPaper Outlined="true" Class="orbit-stat">
            <div class="orbit-stat-label">Tasks</div>
            <div class="orbit-stat-value">@s.Tasks</div>
            @if (s.UnestimatedTasks > 0)
            {
                <div class="orbit-sub">@s.UnestimatedTasks unestimated</div>
            }
        </MudPaper>
        <MudPaper Outlined="true" Class="orbit-stat">
            <div class="orbit-stat-label" title="All time logged to date on the estimated tasks worked on (cancelled ones aside), against their estimates">Estimate variance</div>
            <div class="orbit-stat-value @ReportText.VarianceClass(s.Estimate.VarianceMinutes)">@(s.Estimate.EstimatedTasks == 0 ? "-" : TimeFormat.Signed(s.Estimate.VarianceMinutes))</div>
            <div class="orbit-sub">@EstimateLine(s.Estimate)</div>
        </MudPaper>
    </div>

    <div class="orbit-chart-grid">
        @foreach (var chart in _charts)
        {
            <MudPaper Outlined="true" Class="@(chart.Wide ? "orbit-chart orbit-chart-wide" : "orbit-chart")">
                <MudText Typo="Typo.subtitle2" HtmlTag="h2" Class="mb-2">@chart.Title</MudText>
                @if (chart.NarrowSvg is { } narrow)
                {
                    @* Drawn twice: the wide one beside two columns of charts, the half-width one when they are one to a row. *@
                    <div class="orbit-chart-body orbit-chart-wide-only">@((MarkupString)chart.Svg)</div>
                    <div class="orbit-chart-body orbit-chart-narrow-only">@((MarkupString)narrow)</div>
                }
                else
                {
                    <div class="orbit-chart-body">@((MarkupString)chart.Svg)</div>
                }
            </MudPaper>
        }
    </div>
</div>

<MudText Typo="Typo.subtitle2" HtmlTag="h2" Class="px-4 pt-2 pb-2">By person</MudText>
@if (Report.People.Count == 0)
{
    <p class="orbit-empty">Nobody logged time for the selected filters.</p>
}
else
{
    <div class="orbit-table-wrap">
        <MudSimpleTable Dense="true" Elevation="0" Class="orbit-tasks orbit-report">
            <thead>
                <tr>
                    <th style="width:26%">Person</th>
                    <th style="width:10%" class="text-right">Logged</th>
                    <th style="width:8%" class="text-right" title="Their share of the time logged">Share</th>
                    <th></th>
                    <th style="width:10%" class="text-right" title="The tasks they logged time on">Tasks</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Report.People)
                {
                    if (p.LoggedNothing)
                    {
                        @* The table sets each row's colour, so the class goes on each cell. *@
                        <tr title="No time logged in the period">
                            <td class="orbit-muted">@p.Name</td>
                            <td class="text-right orbit-muted">@TimeFormat.Minutes(0)</td>
                            <td class="text-right orbit-muted">-</td>
                            <td></td>
                            <td class="text-right orbit-muted">0</td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td>@p.Name</td>
                            <td class="text-right"><b>@TimeFormat.Minutes(p.Minutes)</b></td>
                            <td class="text-right">@ReportText.ShareText(p.Minutes, s.Minutes)</td>
                            <td><MudProgressLinear Value="@ReportText.Share(p.Minutes, maxPerson)" Color="Color.Primary" Rounded="true" Size="Size.Medium" /></td>
                            <td class="text-right">@p.Tasks</td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr>
                    <td><b>Total</b></td>
                    <td class="text-right"><b>@TimeFormat.Minutes(s.Minutes)</b></td>
                    <td></td>
                    <td></td>
                    <td class="text-right" title="Each task once, though several people worked on it"><b>@s.Tasks</b></td>
                </tr>
            </tfoot>
        </MudSimpleTable>
    </div>
}

<MudText Typo="Typo.subtitle2" HtmlTag="h2" Class="px-4 pt-4 pb-2">By task</MudText>
@if (Report.Tasks.Count == 0)
{
    <p class="orbit-empty">No time logged for the selected filters.</p>
}
else
{
    <div class="orbit-table-wrap">
        <MudSimpleTable Dense="true" Elevation="0" Class="orbit-tasks orbit-report">
            <thead>
                <tr>
                    <th>Task</th>
                    <th>Status</th>
                    <th class="text-right" title="Time logged on it in the period, and its share of all the time logged">Logged</th>
                    <th style="width:10%"></th>
                    <th class="text-right" title="The people who logged time on it in the period">People</th>
                    <th class="text-right">Estimate</th>
                    <th class="text-right" title="All time logged on it to date, by anyone">To date</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Report.Tasks)
                {
                    var id = t.TaskId;
                    var open = _open.Contains(id);
                    <tr>
                        <td>
                            <div class="orbit-gap-row">
                                @if (t.Restricted)
                                {
                                    @* A task the viewer can't open (§12): its number and department, no title or link. *@
                                    <span><span class="orbit-number">@t.Number</span><span class="orbit-muted">@t.DepartmentName</span></span>
                                }
                                else
                                {
                                    <span><span class="orbit-number">@t.Number</span><a href="@($"/Tasks/Details/{t.TaskId}")" class="orbit-title">@t.Title</a></span>
                                }
                                @if (t.Type != TaskType.Task)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="TaskLook.Type(t.Type)" Class="@TaskLook.TypeClass(t.Type)" title="Type">@t.Type</MudChip>
                                }
                            </div>
                            @if (t.Project is { } p && t.Restricted)
                            {
                                <div class="orbit-sub">@($"{p.Number} {p.Name}".Trim())</div>
                            }
                            else if (t.Project is { } linked)
                            {
                                <div class="orbit-sub"><a href="@($"/Projects/Details/{linked.Id}")">@($"{linked.Number} {linked.Name}".Trim())</a></div>
                            }
                            else
                            {
                                <div class="orbit-sub">No project</div>
                            }
                        </td>
                        <td><MudChip T="string" Size="Size.Small" Color="TaskLook.Status(t.Status)">@t.Status.Label()</MudChip></td>
                        <td class="text-right">
                            <b>@TimeFormat.Minutes(t.Minutes)</b>
                            <div class="orbit-sub">@ReportText.ShareText(t.Minutes, s.Minutes)</div>
                        </td>
                        <td><MudProgressLinear Value="@ReportText.Share(t.Minutes, maxTask)" Color="Color.Primary" Rounded="true" Size="Size.Medium" /></td>
                        <td class="text-right">
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="() => Toggle(id)"
                                       EndIcon="@(open ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                       aria-expanded="@(open ? "true" : "false")" title="Show who logged time on it">@t.People.Count</MudButton>
                        </td>
                        <td class="text-right">@ReportText.Estimate(t.EstimateMinutes)</td>
                        <td class="text-right">@TimeFormat.Minutes(t.TotalMinutes)</td>
                        <td>
                            @if (t.IsOver)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" title="More time has been logged than was estimated">Over estimate</MudChip>
                            }
                            else if (ReportText.Marker(t.Status, t.EstimateMinutes, t.IsOver) is { Length: > 0 } note)
                            {
                                <span class="orbit-muted">@note</span>
                            }
                        </td>
                    </tr>
                    @if (open)
                    {
                        <tr class="orbit-report-detail">
                            <td colspan="8" class="pa-0">
                                <table>
                                    <thead>
                                        <tr>
                                            <th class="orbit-muted ps-10">Person</th>
                                            <th class="orbit-muted text-right" title="Their time on the task in the period">Logged</th>
                                            <th class="orbit-muted text-right" title="Their share of the task's time in the period">Share</th>
                                            <th class="orbit-muted text-right" title="Their time on the task to date">To date</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var x in t.People)
                                        {
                                            <tr>
                                                <td class="ps-10">@x.Name</td>
                                                <td class="text-right">@TimeFormat.Minutes(x.Minutes)</td>
                                                <td class="text-right">@ReportText.ShareText(x.Minutes, t.Minutes)</td>
                                                <td class="text-right">@TimeFormat.Minutes(x.ToDateMinutes)</td>
                                                <td>
                                                    @if (x.IsAssignee)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" title="Assigned to the task">Assignee</MudChip>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr>
                    <td>
                        <b>Total</b>
                        <div class="orbit-sub" title="The tasks worked on, each once">@Tasks(s.Tasks)</div>
                    </td>
                    <td></td>
                    <td class="text-right"><b>@TimeFormat.Minutes(s.Minutes)</b></td>
                    <td></td>
                    <td></td>
                    <td class="text-right" title="The estimates of the tasks that have one (cancelled ones aside)"><b>@ReportText.Estimated(s.Estimate)</b></td>
                    <td class="text-right" title="All time logged to date on those estimated tasks"><b>@ReportText.Actual(s.Estimate)</b></td>
                    <td class="@ReportText.VarianceClass(s.Estimate.VarianceMinutes)"><b>@ReportText.Variance(s.Estimate)</b></td>
                </tr>
            </tfoot>
        </MudSimpleTable>
    </div>
}
<div class="orbit-card-footer">
    Time counts in the period by the day it was logged for, first and last days included. An entry takes its project and
    department from its task, as time logging does, so the department and project filters pick the time logged on their tasks,
    whoever logged it. The Person filter keeps only the time that person logged; To date is always everyone's time on the task,
    on any day. Estimated, To date and variance compare the estimated tasks worked on (cancelled ones aside) with all time logged
    on them to date. A task several people worked on shows each of them when opened, and counts once in the totals. Active people
    in the department reported on who logged nothing in the period are listed last under By person, greyed out. The time chart
    has a column per day for a period up to 62 days, per ISO week (Monday to Sunday) up to 366 days, and per month beyond. The
    projects and people charts show the eleven with the most time and put the rest together past twelve.
</div>

@code {
    [Parameter, EditorRequired] public TimeUtilisationReport Report { get; set; } = null!;

    /// <summary>The tasks whose people are showing, by id, so they stay open when a filter changes and the report reloads.</summary>
    private readonly HashSet<Guid> _open = [];
    private IReadOnlyList<SprintCharts.Chart> _charts = [];

    protected override void OnParametersSet() => _charts = TimeUtilisationCharts.All(Report);

    private void Toggle(Guid id)
    {
        if (!_open.Remove(id)) _open.Add(id);
    }

    private static string Tasks(int n) => n == 1 ? "1 task" : $"{n} tasks";

    /// <summary>"40h estimated · 46h logged · 3 over estimate", or "nothing estimated".</summary>
    private static string EstimateLine(EstimateComparison e) =>
        e.EstimatedTasks == 0 ? "nothing estimated"
        : $"{ReportText.Estimated(e)} estimated · {ReportText.Actual(e)} logged" + (e.OverTasks > 0 ? $" · {e.OverTasks} over estimate" : "");
}
