@* Sprint status (spec §12): one sprint's planned work beside the unplanned work done in its window - the Not Planned work, and the
   Backlog and other sprints' tasks worked on anyway - for the sprint's review at sprint planning. Summary tiles and seven charts
   (SprintCharts, the same SVG as the PDF's: Planned work outcome across the top, then by project, by person and per day, tasks on
   the left and time on the right), the people planned against unplanned, then one row per project - its planned tasks, then its
   Not Planned, Backlog and other sprints' tasks worked on anyway, the same rows as the projects charts (decision 129), with the
   project's status beside its name (decision 131) - and the tasks on no project last, each opening on its people and tasks. The Backlog and other-sprint columns and totals show only when
   such tasks were worked on (SprintStatusSummary.Unplanned). *@

@if (Report.Sprint is not { } sprint)
{
    <p class="orbit-empty">No sprint has started yet: a sprint's report shows here once it has.</p>
}
else
{
    var s = Report.Summary;
    var unplanned = s.Unplanned;
    var unplannedDoneBefore = unplanned.Sum(k => s.Of(k).Tasks.DoneBeforeSprint);
    // The time tile's line, joined here rather than set beside @if blocks, which would drop the spaces between its parts.
    List<string> timeParts =
    [
        $"{TimeFormat.Minutes(s.Planned.SprintMinutes)} planned",
        .. unplanned.Select(k => $"{TimeFormat.Minutes(s.Of(k).SprintMinutes)} {TimeLabel(k)}")
    ];
    var plannedLook = SprintWorkLook.Of(SprintWorkKind.Planned);
    <div class="orbit-list-item orbit-small">
        @if (!string.IsNullOrWhiteSpace(sprint.Goal))
        {
            <div><b>Goal:</b> @sprint.Goal</div>
        }
        <div class="orbit-muted">@ReportText.AsAt(Report)</div>
    </div>

    <div class="orbit-report-summary">
        <div class="orbit-stats orbit-stats-6">
            <MudPaper Outlined="true" Class="orbit-stat">
                <div class="orbit-stat-label">Planned tasks</div>
                <div class="orbit-stat-value">@s.Planned.Tasks.Total</div>
                <div class="orbit-sub">@(s.Planned.Tasks.CarriedIn > 0 ? $"{s.Planned.Tasks.CarriedIn} carried in" : "none carried in")</div>
            </MudPaper>
            <MudPaper Outlined="true" Class="orbit-stat">
                <div class="orbit-stat-label">Done</div>
                <div class="orbit-stat-value">@s.Planned.Tasks.Done</div>
                <div class="orbit-sub">@(s.Planned.Tasks.Total == 0 ? "-" : $"{s.Planned.Tasks.PercentDone}% of the planned tasks")</div>
                @if (s.Planned.Tasks.DoneBeforeSprint > 0)
                {
                    <div class="orbit-sub" title="Planned tasks already Done when the sprint started: they stayed in it, as only open tasks roll forward">@s.Planned.Tasks.DoneBeforeSprint done before the sprint</div>
                }
                @if (s.Planned.Tasks.Total > 0)
                {
                    <MudProgressLinear Value="s.Planned.Tasks.PercentDone" Color="Color.Success" Rounded="true" Class="mt-1" />
                }
            </MudPaper>
            <MudPaper Outlined="true" Class="orbit-stat">
                <div class="orbit-stat-label">Left open</div>
                <div class="orbit-stat-value">@s.Planned.Tasks.LeftOpen</div>
                @if (s.Planned.Tasks.LeftOpen > 0)
                {
                    <div class="orbit-sub" title="Each left-open task's estimate less all time logged on it, never below nothing">Estimate left: @ReportText.Remaining(s.Planned.Tasks)</div>
                }
                @if (Report.LeftOpenTo is { } to && s.Planned.Tasks.LeftOpen > 0)
                {
                    <div class="orbit-sub">went to @to</div>
                }
            </MudPaper>
            <MudPaper Outlined="true" Class="orbit-stat">
                <div class="orbit-stat-label">Not Planned tasks</div>
                <div class="orbit-stat-value">@s.NotPlanned.Tasks.Total</div>
                <div class="orbit-sub">@s.NotPlanned.Tasks.Done done · @s.NotPlanned.Tasks.LeftOpen open</div>
                @if (s.HasBacklog)
                {
                    <div class="orbit-sub" title="Backlog tasks logged against or set to Done during the sprint, though not planned into it">+ @s.Backlog.Tasks.Total from the Backlog (@s.Backlog.Tasks.Done done)</div>
                }
                @if (s.HasOtherSprint)
                {
                    <div class="orbit-sub" title="Tasks of other sprints - later ones worked on ahead, earlier ones reopened or logged against - logged against or set to Done during this one">+ @s.OtherSprint.Tasks.Total from other sprints (@s.OtherSprint.Tasks.Done done)</div>
                }
                @if (unplannedDoneBefore > 0)
                {
                    <div class="orbit-sub" title="Unplanned tasks already Done when the sprint started, and only logged against during it: their outcome is Done, but they weren't done in this sprint">@unplannedDoneBefore done before the sprint</div>
                }
            </MudPaper>
            <MudPaper Outlined="true" Class="orbit-stat">
                <div class="orbit-stat-label">Logged in the sprint</div>
                <div class="orbit-stat-value">@TimeFormat.Minutes(s.SprintMinutes)</div>
                <div class="orbit-sub orbit-gap-row">
                    <span>@string.Join(" · ", timeParts)</span>
                    @if (s.UnplannedPercent is int share)
                    {
                        <b title="Unplanned work's share: Not Planned, Backlog and other-sprint work">(@share% unplanned)</b>
                    }
                </div>
            </MudPaper>
            <MudPaper Outlined="true" Class="orbit-stat">
                <div class="orbit-stat-label" title="All time logged to date on the estimated tasks (cancelled ones aside), against their estimates">Estimate variance</div>
                <div class="orbit-stat-value @ReportText.VarianceClass(s.AllEstimate.VarianceMinutes)">@(s.AllEstimate.EstimatedTasks == 0 ? "-" : TimeFormat.Signed(s.AllEstimate.VarianceMinutes))</div>
                <div class="orbit-sub">@ReportText.Estimated(s.AllEstimate) estimated · @ReportText.Actual(s.AllEstimate) logged</div>
            </MudPaper>
        </div>

        <div class="orbit-chart-grid">
            @foreach (var chart in _charts)
            {
                <MudPaper Outlined="true" Class="@(chart.Wide ? "orbit-chart orbit-chart-wide" : "orbit-chart")">
                    <MudText Typo="Typo.subtitle2" HtmlTag="h2" Class="mb-2">@chart.Title</MudText>
                    @if (chart.NarrowSvg is { } narrow)
                    {
                        @* Drawn twice: the wide one beside two columns of charts, the half-width one when they are one to a row. *@
                        <div class="orbit-chart-body orbit-chart-wide-only">@((MarkupString)chart.Svg)</div>
                        <div class="orbit-chart-body orbit-chart-narrow-only">@((MarkupString)narrow)</div>
                    }
                    else
                    {
                        <div class="orbit-chart-body">@((MarkupString)chart.Svg)</div>
                    }
                </MudPaper>
            }
        </div>
    </div>

    <MudText Typo="Typo.subtitle2" HtmlTag="h2" Class="px-4 pt-2 pb-2">By person</MudText>
    @if (Report.People.Count == 0)
    {
        <p class="orbit-empty">Nobody has a task or logged time in this sprint.</p>
    }
    else
    {
        <div class="orbit-table-wrap">
            <MudSimpleTable Dense="true" Elevation="0" Class="orbit-tasks orbit-report">
                <thead>
                    <tr>
                        <th>Person</th>
                        <th class="text-right" title="@plannedLook.TasksTitle">@plannedLook.TasksColumn</th>
                        <th class="text-right">Done</th>
                        <th class="text-right">Left open</th>
                        @foreach (var k in unplanned)
                        {
                            var look = SprintWorkLook.Of(k);
                            <th class="text-right" title="@look.TasksTitle">@look.TasksColumn</th>
                        }
                        <th class="text-right" title="@plannedLook.TimeTitle">@plannedLook.TimeColumn</th>
                        @foreach (var k in unplanned)
                        {
                            var look = SprintWorkLook.Of(k);
                            <th class="text-right" title="@look.TimeTitle">@look.TimeColumn</th>
                        }
                        <th class="text-right" title="Unplanned work's share (Not Planned, Backlog and other-sprint work) of the time they logged in the sprint">Unplanned share</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Report.People)
                    {
                        <tr>
                            <td class="@(p.UserId is null ? "orbit-muted" : null)">
                                @if (p.UserId is null)
                                {
                                    <i>@p.Name</i>
                                }
                                else
                                {
                                    @p.Name
                                }
                            </td>
                            <td class="text-right">@p.PlannedTasks</td>
                            <td class="text-right">@p.PlannedDone</td>
                            <td class="text-right">@p.PlannedLeftOpen</td>
                            @foreach (var k in unplanned)
                            {
                                <td class="text-right">@p.Tasks.Of(k)</td>
                            }
                            <td class="text-right">@TimeFormat.Minutes(p.PlannedMinutes)</td>
                            @foreach (var k in unplanned)
                            {
                                <td class="text-right">@TimeFormat.Minutes(p.Minutes.Of(k))</td>
                            }
                            <td class="text-right">@ReportText.Percent(p.UnplannedPercent)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td>Total</td>
                        <td class="text-right">@(s.Planned.Tasks.Total - s.Planned.Tasks.Cancelled)</td>
                        <td class="text-right">@s.Planned.Tasks.Done</td>
                        <td class="text-right">@s.Planned.Tasks.LeftOpen</td>
                        @foreach (var k in unplanned)
                        {
                            <td class="text-right">@(s.Of(k).Tasks.Total - s.Of(k).Tasks.Cancelled)</td>
                        }
                        <td class="text-right">@TimeFormat.Minutes(s.Planned.SprintMinutes)</td>
                        @foreach (var k in unplanned)
                        {
                            <td class="text-right">@TimeFormat.Minutes(s.Of(k).SprintMinutes)</td>
                        }
                        <td class="text-right">@ReportText.Percent(s.UnplannedPercent)</td>
                    </tr>
                </tfoot>
            </MudSimpleTable>
        </div>
    }

    <MudText Typo="Typo.subtitle2" HtmlTag="h2" Class="px-4 pt-4 pb-2">By project</MudText>
    @if (Report.Rows.Count == 0)
    {
        <p class="orbit-empty">No tasks for the selected filters.</p>
    }
    else
    {
        <div class="orbit-table-wrap">
            <MudSimpleTable Dense="true" Elevation="0" Class="orbit-tasks orbit-report">
                <thead>
                    <tr>
                        <th>Project</th>
                        <th style="width:12%">Progress</th>
                        <th class="text-right">Done</th>
                        <th class="text-right" title="Open when the sprint ended, or open now while it runs">Left open</th>
                        <th class="text-right">Cancelled</th>
                        <th class="text-right" title="Everyone's time dated in the sprint, and all time logged to date">Logged in sprint</th>
                        <th class="text-right" title="The estimates of the tasks that have one (cancelled ones aside)">Estimated</th>
                        <th class="text-right" title="All time logged on the estimated tasks to date, against their estimates">Variance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in Report.Rows)
                    {
                        var t = g.Tasks;
                        var key = g.Key;
                        var open = _open.Contains(key);
                        // The tasks worked on though not planned into the sprint follow the row's planned ones, under a heading.
                        var firstOffPlan = g.UnplannedTaskRows.FirstOrDefault();
                        // The No project row, always last, is set apart from the project rows above it, when there are any.
                        <tr class="@(g.Project is null && Report.Rows.Count > 1 ? "orbit-report-section" : null)">
                            <td>
                                @if (g.Project is { } p)
                                {
                                    @* The project's status now, as the tasks' Status column has theirs (decision 131). *@
                                    <span class="orbit-number">@p.Number</span><a href="@($"/Projects/Details/{p.Id}")" class="orbit-title">@p.Name</a><MudChip T="string" Size="Size.Small" Color="StatusLook.Project(p.Status)">@p.Status.Label()</MudChip>
                                    <div class="orbit-sub">@p.DepartmentName</div>
                                }
                                else
                                {
                                    <b>@g.Name</b>
                                    <div class="orbit-sub">Tasks on no project</div>
                                }
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="() => Toggle(key)"
                                           EndIcon="@(open ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                           aria-expanded="@(open ? "true" : "false")">People and tasks</MudButton>
                            </td>
                            <td>
                                <div class="orbit-small">@ReportText.Progress(t)</div>
                                <MudProgressLinear Value="t.PercentDone" Color="Color.Success" Rounded="true" title="@($"{t.PercentDone}% done")" />
                                @if (g.UnplannedTasks.Total > 0)
                                {
                                    <div class="orbit-sub" title="Done of the planned tasks, and of those worked on though not planned into the sprint (Not Planned, from the Backlog or from another sprint)">@ReportText.PlannedSplit(g)</div>
                                }
                            </td>
                            <td class="text-right">@t.Done</td>
                            <td class="text-right">
                                @t.LeftOpen
                                @if (t.LeftOpen > 0 && t.LeftOpenRemainingMinutes > 0)
                                {
                                    <div class="orbit-sub text-nowrap">@TimeFormat.Minutes(t.LeftOpenRemainingMinutes) left</div>
                                }
                                @if (g.UnplannedTasks.LeftOpen > 0)
                                {
                                    <div class="orbit-sub text-nowrap" title="Of them, the tasks worked on though not planned into the sprint, and the estimate left on them: they don't go on to the next sprint">@ReportText.UnplannedLeftOpen(g)</div>
                                }
                            </td>
                            <td class="text-right">@t.Cancelled</td>
                            <td class="text-right">
                                <b>@TimeFormat.Minutes(g.SprintMinutes)</b>
                                <div class="orbit-sub text-nowrap">@TimeFormat.Minutes(g.ToDateMinutes) to date</div>
                                @if (g.UnplannedTasks.Total > 0)
                                {
                                    <div class="orbit-sub text-nowrap" title="Time in the sprint on the tasks worked on though not planned into it">@TimeFormat.Minutes(g.UnplannedSprintMinutes) unplanned</div>
                                }
                            </td>
                            <td class="text-right">@ReportText.Estimated(g.Estimate)</td>
                            <td class="text-right">
                                <span class="@ReportText.VarianceClass(g.Estimate.VarianceMinutes)">@ReportText.Variance(g.Estimate)</span>
                                @if (g.Estimate.OverTasks > 0)
                                {
                                    <div class="orbit-sub">@g.Estimate.OverTasks over estimate</div>
                                }
                            </td>
                        </tr>
                        @if (open)
                        {
                            <tr class="orbit-report-detail">
                                <td colspan="8" class="pa-0">
                                    <table>
                                        <thead>
                                            <tr>
                                                <th class="orbit-muted ps-10">Person</th>
                                                <th class="orbit-muted text-right" title="Their tasks here (cancelled ones aside). A task several people share counts for each of them.">Tasks</th>
                                                <th class="orbit-muted text-right">Done</th>
                                                <th class="orbit-muted text-right">Left open</th>
                                                <th class="orbit-muted text-right" title="The estimates of their tasks here. A shared task's estimate counts in full for each of its assignees.">Estimated</th>
                                                <th class="orbit-muted text-right" title="Their own time on these tasks, dated in the sprint">Logged in sprint</th>
                                                <th class="orbit-muted text-right" title="Their own time on these tasks to date">Logged to date</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var x in g.People)
                                            {
                                                <tr>
                                                    <td class="@(x.UserId is null ? "ps-10 orbit-muted" : "ps-10")">
                                                        @if (x.UserId is null)
                                                        {
                                                            <i>@x.Name</i>
                                                        }
                                                        else
                                                        {
                                                            @x.Name
                                                        }
                                                    </td>
                                                    <td class="text-right">@x.Tasks</td>
                                                    <td class="text-right">@x.Done</td>
                                                    <td class="text-right">@x.LeftOpen</td>
                                                    <td class="text-right">@ReportText.Estimated(x)</td>
                                                    <td class="text-right">@TimeFormat.Minutes(x.SprintMinutes)</td>
                                                    <td class="text-right">@TimeFormat.Minutes(x.ToDateMinutes)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                    <table class="orbit-report-tasks">
                                        <thead>
                                            <tr>
                                                <th class="orbit-muted ps-10">Task</th>
                                                <th class="orbit-muted">Status</th>
                                                <th class="orbit-muted" title="Where the task ended the sprint">Outcome</th>
                                                <th class="orbit-muted">Assignee</th>
                                                <th class="orbit-muted text-right">Estimate</th>
                                                <th class="orbit-muted text-right" title="Everyone's time on the task, dated in the sprint">Logged in sprint</th>
                                                <th class="orbit-muted text-right" title="All time logged on the task to date, by anyone">Logged to date</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var x in g.TaskRows)
                                            {
                                                if (ReferenceEquals(x, firstOffPlan))
                                                {
                                                    <tr class="orbit-report-subhead">
                                                        <td colspan="8" class="ps-10" title="Not Planned, from the Backlog or from another sprint: worked on during the sprint though not planned into it">Worked on, not planned into the sprint</td>
                                                    </tr>
                                                }
                                                <tr>
                                                    <td class="ps-10">
                                                        <span class="orbit-number">@x.Number</span><a href="@($"/Tasks/Details/{x.TaskId}")" class="orbit-title">@x.Title</a>
                                                    </td>
                                                    <td><MudChip T="string" Size="Size.Small" Color="TaskLook.Status(x.Status)">@x.Status.Label()</MudChip></td>
                                                    <td><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="OutcomeColour(x.Outcome)">@ReportText.Label(x.Outcome)</MudChip></td>
                                                    <td>@x.Assignee</td>
                                                    <td class="text-right">@ReportText.Estimate(x.EstimateMinutes)</td>
                                                    <td class="text-right">@TimeFormat.Minutes(x.SprintMinutes)</td>
                                                    <td class="text-right">@TimeFormat.Minutes(x.TotalMinutes)</td>
                                                    <td>
                                                        <div class="orbit-gap-row">
                                                            @if (x.IsOver)
                                                            {
                                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" title="More time has been logged than was estimated">Over estimate</MudChip>
                                                            }
                                                            <span class="orbit-muted orbit-small">@ReportText.Note(x, withOver: false)</span>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    @foreach (var (label, t, sprintMinutes, toDate, estimate) in Totals(s))
                    {
                        <tr>
                            <td>@label</td>
                            <td class="orbit-small">@ReportText.Progress(t)</td>
                            <td class="text-right">@t.Done</td>
                            <td class="text-right">@t.LeftOpen</td>
                            <td class="text-right">@t.Cancelled</td>
                            <td class="text-right">
                                @TimeFormat.Minutes(sprintMinutes)
                                <div class="orbit-sub text-nowrap">@TimeFormat.Minutes(toDate) to date</div>
                            </td>
                            <td class="text-right">@ReportText.Estimated(estimate)</td>
                            <td class="text-right @ReportText.VarianceClass(estimate.VarianceMinutes)">@ReportText.Variance(estimate)</td>
                        </tr>
                    }
                </tfoot>
            </MudSimpleTable>
        </div>
    }
    <div class="orbit-card-footer">
        The sprint's window is its start date to its end date, both days included; time counts in it by the day it was logged for.
        Planned tasks are those in the sprint and, once it has ended, the open ones it handed on to the next sprint or the Backlog
        (read from the sprint's completion), so a past sprint still shows what was left open. Outcomes are each task's status as at
        the sprint's completion, read from its status history, or now while it runs: Done, Left open or Cancelled. Later changes
        don't alter them: a task closed when the sprint ended and reopened since keeps its outcome, marked Reopened since. A task
        already Done when the sprint started, and unchanged since, is marked Done before the sprint and keeps its outcome: a planned
        one stayed in the sprint it was planned for, as only open tasks roll forward; an unplanned one only had time logged in it.
        Tasks are placed by where they are now. Not Planned work is the tasks that are Not Planned now and were created, set to Done
        or logged against in the window. Backlog work is the tasks on the Backlog now that were logged against or set to Done in the
        window, though not planned into the sprint. Other-sprint work is the tasks in any other sprint - a later one, worked on
        ahead, or an earlier one, such as a finished task reopened - that were logged against or set to Done in the window. Each
        shows on its project's row, or No project, after the planned tasks, marked Not Planned, From the Backlog, Planned for a sprint
        that starts later, or From any other sprint; the row's figures cover them too, and its progress, left open and time say how
        much was unplanned. The rows are the projects charts' projects, though past twelve the charts put the ones with the least
        time together. So a task since moved off Not Planned or the Backlog shows as the Backlog's or another
        sprint's instead, and drops out only if it was just created in the window. The project filter offers the projects with a
        row. Not Planned, Backlog and other-sprint work together are the unplanned work, so
        every task logged against or set to Done in the window is in one row or another, the department and the filters aside. The
        unplanned share is their part of the time logged in the sprint. Created and completed times count by the UTC day. The
        estimate left on the left-open tasks is each one's estimate less all time logged on it, never below nothing. Estimated and
        variance compare the estimated tasks (those cancelled when the sprint ended aside) with all time logged on them to date.
        The projects and people charts show the twelve with the most time in the sprint, the rest together, and the two charts of a
        pair show the same ones. Tasks per day counts each task once, on the last day in the window it was set to Done; a task
        finished before the sprint isn't in it. The project and assignee filters pick tasks (the project's, the person's, shared
        ones included); a picked task's figures still cover everyone's time. The department is the task's.
    </div>
}

@code {
    [Parameter, EditorRequired] public SprintStatusReport Report { get; set; } = null!;

    /// <summary>
    /// The groups whose people and tasks are showing, by key, so they stay open when a filter changes and the report reloads
    /// (<c>ReportView</c> keeps this component, so this set, across runs). Another sprint closes them all.
    /// </summary>
    private readonly HashSet<string> _open = [];
    private Guid? _sprintId;
    private IReadOnlyList<SprintCharts.Chart> _charts = [];

    protected override void OnParametersSet()
    {
        if (Report.Sprint?.Id != _sprintId) _open.Clear();
        _sprintId = Report.Sprint?.Id;
        _charts = SprintCharts.All(Report);
    }

    private void Toggle(string key)
    {
        if (!_open.Remove(key)) _open.Add(key);
    }

    private static Color OutcomeColour(SprintTaskOutcome o) => o switch
    {
        SprintTaskOutcome.Done => Color.Success,
        SprintTaskOutcome.LeftOpen => Color.Warning,
        _ => Color.Default
    };

    /// <summary>The totals rows: planned work, each unplanned kind with tasks, then all work.</summary>
    private static IEnumerable<(string Label, SprintTaskCounts Tasks, int SprintMinutes, int ToDate, EstimateComparison Estimate)> Totals(SprintStatusSummary s)
    {
        foreach (var kind in s.Unplanned.Where(k => s.Of(k).Tasks.Total > 0).Prepend(SprintWorkKind.Planned))
        {
            var t = s.Of(kind);
            yield return (SprintWorkLook.Of(kind).Name, t.Tasks, t.SprintMinutes, t.ToDateMinutes, t.Estimate);
        }
        yield return ("All work", s.All, s.SprintMinutes, s.ToDateMinutes, s.AllEstimate);
    }

    /// <summary>A kind of work's time on the time tile: "planned", "Not Planned", "Backlog", "other sprint".</summary>
    private static string TimeLabel(SprintWorkKind kind) => kind == SprintWorkKind.OtherSprint ? "other sprint" : SprintWorkLook.Of(kind).ChartName;
}
