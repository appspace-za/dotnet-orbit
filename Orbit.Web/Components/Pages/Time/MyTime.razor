@page "/Time/My"
@inherits OrbitComponentBase
@* My Time (spec §6.10): the time the viewer logged in a date range - the last seven days by default - as entries with a total,
   and by day. The range lives in the address (From, To) and applies as soon as a date changes. The pickers show the range read
   from the address, never the loaded one: a MudDatePicker handed a date other than its own raises DateChanged with it, so the
   older range showing while the new one loaded sent the page back to it, and back again, for ever (§13 item 143). *@

<PageTitle>My Time - Orbit</PageTitle>

@if (Refusal is not null)
{
    <AccessDenied Message="@Refusal" />
}
else if (_summary is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    var s = _summary;
    <div class="orbit-page-header">
        <div>
            <MudText Typo="Typo.h5" HtmlTag="h1">My Time</MudText>
            <div class="orbit-subtitle">Time you logged between @Ui.Day(s.From) and @Ui.Day(s.To).</div>
        </div>
        <div class="orbit-actions">
            <MudDatePicker Date="PickerDate.Of(_from)" DateChanged="d => Go(PickerDate.Day(d), _to)" Label="From" DateFormat="yyyy-MM-dd" Editable="true" AutoClose="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Class="orbit-field-sm" />
            <MudDatePicker Date="PickerDate.Of(_to)" DateChanged="d => Go(_from, PickerDate.Day(d))" Label="To" DateFormat="yyyy-MM-dd" Editable="true" AutoClose="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Class="orbit-field-sm" />
        </div>
    </div>

    <MudGrid Spacing="3">
        <MudItem xs="12" lg="8">
            <MudPaper Outlined="true" Class="orbit-card">
                <div class="orbit-card-header"><b>Entries</b><span>Total: <b>@TimeFormat.Minutes(s.TotalMinutes)</b></span></div>
                @if (s.Entries.Count == 0)
                {
                    <p class="orbit-empty">No time logged in this range.</p>
                }
                else
                {
                    <div class="orbit-table-wrap">
                        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="orbit-tasks">
                            <thead><tr><th>Date</th><th>Task</th><th>Project</th><th>Duration</th><th>Note</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var e in s.Entries)
                                {
                                    <tr @key="e.Id">
                                        <td class="text-nowrap">@Ui.Day(e.Date)</td>
                                        <td><a href="@($"/Tasks/Details/{e.TaskId}")" class="orbit-title">@e.Task.Title</a></td>
                                        <td>@(e.Task.Project?.Name ?? "-")</td>
                                        <td class="text-nowrap">@TimeFormat.Minutes(e.DurationMinutes)</td>
                                        <td>@e.Note</td>
                                        <td class="text-right"><MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Href="@($"/Time/Edit/{e.Id}")">Edit</MudButton></td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </div>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="4">
            <MudPaper Outlined="true" Class="orbit-card">
                <div class="orbit-card-header"><b>By day</b></div>
                @if (s.ByDay.Count == 0)
                {
                    <div class="orbit-list-item orbit-muted"><i>-</i></div>
                }
                @foreach (var (date, minutes) in s.ByDay)
                {
                    <div class="orbit-list-item orbit-list-row" @key="date"><span>@date.ToString("ddd, d MMM")</span><span>@TimeFormat.Minutes(minutes)</span></div>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [SupplyParameterFromQuery] public string? From { get; set; }
    [SupplyParameterFromQuery] public string? To { get; set; }

    private MyTimeSummary? _summary;
    /// <summary>The range in the address, which the pickers show. Set before the entries load, so they show it while they do.</summary>
    private DateOnly _from, _to;

    protected override async Task OnParametersSetAsync()
    {
        var (from, to) = FilterQuery.Period(FilterQuery.Date(From), FilterQuery.Date(To), DateOnly.FromDateTime(DateTime.UtcNow), 6);
        (_from, _to) = (from, to);
        await Load(async s => _summary = await s.Get<TimeEntryService>().MyTimeAsync(from, to));
    }

    private void Go(DateOnly? from, DateOnly? to)
    {
        // A picker handed a date other than its own (the range put in order, say) raises DateChanged with it: that is the range
        // already shown, so there is nowhere to go.
        if (from == _from && to == _to) return;
        Nav.NavigateTo(new FilterQuery().Add(nameof(From), from).Add(nameof(To), to).At("/Time/My"));
    }
}
