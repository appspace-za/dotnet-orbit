@page "/Today"
@page "/Today/Index"
@inherits OrbitComponentBase
@using Microsoft.Extensions.Options
@inject IOptions<CriticalPathOptions> CriticalPath
@* The day plan (spec §6.12, decision 136): the team's plan for the morning meeting, one view at a time - the Summary, what became of
   the last plan (Yesterday), and a stand-up for each person planned today (Components/DayPlans). It shows tasks rather than
   changes them: planning happens on the task lists, so carrying unfinished tasks over is the one change made here. The view is in
   the address (?View=) and isn't remembered, so the page opens on the Summary; each switch reloads, so changes people make
   elsewhere show up as the meeting goes round. *@

<PageTitle>Today - Orbit</PageTitle>

@if (Refusal is not null)
{
    <AccessDenied Message="@Refusal" />
}
else if (_plan is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    var plan = _plan;

    <div class="orbit-page-header">
        <div>
            <MudText Typo="Typo.h5" HtmlTag="h1">Today <span class="orbit-subtitle">@_today.ToString("dddd, d MMMM yyyy")</span></MudText>
            <div class="orbit-subtitle">The team's plan for the morning meeting. Tick "Today" on any task list to add to it.</div>
        </div>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
            @if (_actor!.CanAnywhere(Permission.TasksView))
            {
                <MudSelect T="Guid" Value="FilterChoice.Id(DepartmentId) ?? Guid.Empty" ValueChanged="DepartmentPicked" Label="Department"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="orbit-inline" ToStringFunc="DepartmentName">
                    <MudSelectItem T="Guid" Value="Guid.Empty">All</MudSelectItem>
                    @foreach (var d in _departments)
                    {
                        <MudSelectItem T="Guid" Value="d.Id">@d.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            @if (_actor.Has(Permission.TasksCreate))
            {
                <MudButton Href="/Tasks/Create" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">New task</MudButton>
            }
        </MudStack>
    </div>

    <div class="orbit-dash orbit-day">
        <div class="orbit-dash-switcher">
            <div class="orbit-day-tabs">
                <MudToggleGroup T="string" Value="_view.Key" ValueChanged="ViewPicked" Color="Color.Primary" Size="Size.Small"
                                Outlined="true" Delimiters="true" aria-label="Today view">
                    <MudToggleItem Value="@DayPlanRules.SummaryKey" Text="Summary" />
                    @if (plan.LastPlanDate is DateOnly last)
                    {
                        <MudToggleItem Value="@DayPlanRules.YesterdayKey" Text="@DayPlanRules.WhenLabel(last, _today)" title="@($"The plan for {last:dddd, d MMMM yyyy}")" />
                    }
                    @foreach (var p in _people)
                    {
                        var overloaded = p.Today.Load(WorkingDayMinutes).Overloaded;
                        <MudToggleItem Value="@p.View.Key" title="@($"{p.Today.Done} of {p.Today.Tasks.Count} done{(overloaded ? " - overloaded" : "")}")">
                            @p.Name<span class="orbit-day-tab-count">@p.Today.Done/@p.Today.Tasks.Count</span>@if (overloaded)
                            {
                                <span class="orbit-day-tab-alert" aria-label="overloaded"></span>
                            }
                        </MudToggleItem>
                    }
                </MudToggleGroup>
            </div>
        </div>

        @switch (_view.Kind)
        {
            case DayPlanViewKind.Yesterday:
                <DayPlanYesterday Plan="plan" Outcomes="_outcomes" Actor="_actor" Waiting="_waiting" PersonKeys="_personKeys" ViewHref="ViewHref"
                                  Selected="_selected" SelectionChanged="StateHasChanged" Busy="_busy"
                                  OnCarrySelected="CarrySelectedAsync" OnCarryAll="CarryAllAsync" />
                break;
            case DayPlanViewKind.Person:
                <DayPlanStandup Person="_people.First(p => p.AssigneeId == _view.AssigneeId)" Plan="plan" Actor="_actor" Waiting="_waiting"
                                WorkingDayMinutes="WorkingDayMinutes" />
                break;
            default:
                <DayPlanSummary Plan="plan" People="_people" Charts="_charts!" Links="_links" Actor="_actor" WorkingDayMinutes="WorkingDayMinutes"
                                ViewHref="ViewHref" />
                break;
        }
    </div>
}

@code {
    private const string ViewKey = "View";

    /// <summary>The view, read as text and resolved leniently: a bad one, or a person with nothing planned today, is the Summary.</summary>
    [SupplyParameterFromQuery(Name = ViewKey)] public string? ViewChoice { get; set; }

    /// <summary>
    /// Someone who sees every department may narrow the plan to one; ignored for everyone else. Read as text, as every filter
    /// is: a typed parameter would crash the page on a bad value, where this is just no filter.
    /// </summary>
    [SupplyParameterFromQuery] public string? DepartmentId { get; set; }

    private Actor? _actor;
    private DateOnly _today;
    private DayPlan? _plan;
    private DayPlanView _view = DayPlanView.Summary;
    /// <summary>Everyone on today's plan, one per button, built once per load for the Summary and the stand-ups.</summary>
    private IReadOnlyList<DayPlanPerson> _people = [];
    private IReadOnlySet<string> _personKeys = new HashSet<string>();
    private IReadOnlyList<DayPlanOutcome> _outcomes = [];
    private DayPlanCharts? _charts;
    private DashboardLinks _links = new(null, null);
    private IReadOnlyDictionary<Guid, WaitingSummary> _waiting = new Dictionary<Guid, WaitingSummary>();
    private IReadOnlyList<Department> _departments = [];
    private readonly HashSet<Guid> _selected = [];
    private bool _busy;

    /// <summary>A working day in minutes (CriticalPath:HoursPerWorkingDay, §6.17): more open estimate than this on one person is an overload.</summary>
    private int WorkingDayMinutes => Math.Max(1, CriticalPath.Value.HoursPerWorkingDay) * 60;

    protected override Task OnParametersSetAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        await Load(async s =>
        {
            var actor = await s.Get<IActorProvider>().GetAsync();
            var today = DateOnly.FromDateTime(DateTime.UtcNow);
            var departmentId = DepartmentFilter(actor);
            var plan = await s.Get<TaskService>().GetDayPlanAsync(today, departmentId);
            var waiting = await s.Get<TaskStructureService>().GetWaitingAsync(plan.Planned.Concat(plan.Unfinished));
            _departments = actor.CanAnywhere(Permission.TasksView) ? await s.Get<DepartmentService>().ListAsync(false) : [];
            var people = DayPlanRules.People(plan, waiting);
            _view = DayPlanRules.ResolveView(ViewChoice, people.Select(p => p.Today).ToList(), plan.HasLastPlan);
            _people = people;
            _personKeys = people.Select(p => p.View.Key).ToHashSet();
            _outcomes = DayPlanRules.Outcomes(plan);
            // The figures' links narrow to the department only for a viewer at All, as the dashboard's do (DashboardLinks).
            _links = new DashboardLinks(null, departmentId);
            _charts = DayPlanCharts.For(plan, _links);
            _waiting = waiting;
            _actor = actor;
            _today = today;
            _plan = plan;
            _selected.IntersectWith(plan.Unfinished.Select(t => t.Id));
        });
    }

    private Guid? DepartmentFilter(Actor actor) => actor.CanAnywhere(Permission.TasksView) ? FilterChoice.Id(DepartmentId) : null;

    /// <summary>Another view's address, keeping the department; the Summary has no key.</summary>
    private string ViewHref(DayPlanView view) =>
        Nav.GetUriWithQueryParameter(ViewKey, view.Kind == DayPlanViewKind.Summary ? null : view.Key);

    private void ViewPicked(string key) =>
        Nav.NavigateTo(Nav.GetUriWithQueryParameter(ViewKey, key == DayPlanRules.SummaryKey ? null : key));

    private string DepartmentName(Guid id) => id == Guid.Empty ? "All" : _departments.FirstOrDefault(d => d.Id == id)?.Name ?? "";

    private void DepartmentPicked(Guid id) =>
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("DepartmentId", id == Guid.Empty ? (Guid?)null : id));

    private async Task CarrySelectedAsync()
    {
        if (_selected.Count == 0)
        {
            Error("Select at least one task.");
            return;
        }
        await CarryOverAsync(_selected.ToList());
    }

    /// <summary>Carries over everything still unfinished from the previous plan; the service picks the tasks.</summary>
    private Task CarryAllAsync() => CarryOverAsync(null);

    private async Task CarryOverAsync(IReadOnlyCollection<Guid>? ids)
    {
        _busy = true;
        var moved = 0;
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        if (await Act(async s =>
            {
                var tasks = s.Get<TaskService>();
                if (ids is null)
                {
                    var actor = await s.Get<IActorProvider>().GetAsync();
                    moved = await tasks.CarryOverUnfinishedAsync(today, DepartmentFilter(actor));
                }
                else
                {
                    moved = await tasks.CarryOverAsync(ids, today);
                }
            }))
        {
            Success(moved == 0 ? "Nothing to carry over." : $"{moved} task(s) carried over to today.");
            _selected.Clear();
            await ReloadAsync();
        }
        _busy = false;
    }
}
