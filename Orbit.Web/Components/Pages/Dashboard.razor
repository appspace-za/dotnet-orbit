@page "/"
@page "/Index"
@inherits OrbitListPage
@* The dashboard (spec §6.9, decision 134), everyone's landing page. It has three purpose-built views - My work, a department's and
   the company's (Components/Dashboards) - and the viewer switches between the ones their task grants reach (DashboardRules.Views).
   The view, and the department someone who sees every department picked, live in the address and are remembered for the browser
   session like a list page's filters (OrbitListPage), so the dashboard opens on the last view picked. A role that sees no tasks gets
   the places it can go instead. The header's buttons start new work, each behind the create permission its page's door asks for. *@

<PageTitle>Dashboard - Orbit</PageTitle>

@if (Refusal is not null)
{
    <AccessDenied Message="@Refusal" />
}
else if (_d is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    var d = _d;
    var actor = d.Actor;

    <div class="orbit-page-header">
        <div>
            <MudText Typo="Typo.h5" HtmlTag="h1">Welcome, @actor.DisplayName</MudText>
            <div class="orbit-subtitle">@actor.Role.Name@(d.HomeDepartmentName is not null ? $" · {d.HomeDepartmentName}" : "") · @d.Today.ToString("dddd, d MMMM yyyy")</div>
        </div>
        @if (actor.Has(Permission.TasksCreate) || actor.Has(Permission.ProjectsCreate) || actor.Has(Permission.AssetsCreate))
        {
            <div class="orbit-actions">
                @if (actor.Has(Permission.TasksCreate))
                {
                    <MudButton Href="/Tasks/Create" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add">New task</MudButton>
                }
                @if (actor.Has(Permission.ProjectsCreate))
                {
                    <MudButton Href="/Projects/Create" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add">New project</MudButton>
                }
                @if (actor.Has(Permission.AssetsCreate))
                {
                    <MudButton Href="/Assets/Create" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add">Register asset</MudButton>
                }
            </div>
        }
    </div>

    @if (d.View is not DashboardView view)
    {
        // A role that sees no tasks (e.g. one that only logs requests): no task widgets, just the parts of Orbit it can use.
        var destinations = Navigation.Visible(actor).Where(i => i.Href != "/").ToList();
        <MudGrid Spacing="3">
            <MudItem xs="12" lg="8">
                <MudPaper Outlined="true" Class="orbit-card">
                    <div class="orbit-card-header"><b>Where to start</b></div>
                    @if (destinations.Count == 0)
                    {
                        <div class="orbit-list-item orbit-muted">Your role doesn't give you access to anything yet. Ask an administrator.</div>
                    }
                    @foreach (var item in destinations)
                    {
                        <a class="orbit-list-item orbit-list-row orbit-plain" href="@item.Href">@item.Label <span class="orbit-muted" aria-hidden="true">&rarr;</span></a>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="12" lg="4">
                @if (_waitingApprovals is { } approvals)
                {
                    <WaitingApprovalsCard Items="approvals" MeId="actor.UserId" />
                }
                @if (_assetChecks is { } checks)
                {
                    <AssetChecksCard Summary="checks" />
                }
            </MudItem>
        </MudGrid>
    }
    else
    {
        <div class="orbit-dash">
            @if (d.Views.Count > 1 || d.Departments.Count > 0)
            {
                <div class="orbit-dash-switcher">
                    @if (d.Views.Count > 1)
                    {
                        <MudToggleGroup T="DashboardView" Value="view" ValueChanged="ViewPickedAsync" Color="Color.Primary" Size="Size.Small"
                                        Outlined="true" Delimiters="true" aria-label="Dashboard view">
                            @foreach (var v in d.Views)
                            {
                                <MudToggleItem Value="v" Text="@ViewLabel(v)" />
                            }
                        </MudToggleGroup>
                    }
                    @if (d.Departments.Count > 0)
                    {
                        <MudSelect T="Guid" Value="d.DepartmentId ?? Guid.Empty" ValueChanged="DepartmentPickedAsync" Label="Department"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="orbit-inline" ToStringFunc="DepartmentName">
                            @foreach (var dept in d.Departments)
                            {
                                <MudSelectItem T="Guid" Value="dept.Id">@dept.Name</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </div>
            }
            @switch (view)
            {
                case DashboardView.Mine:
                    <MyWorkDashboard Model="d" Charts="_charts!" Approvals="_waitingApprovals" AssetChecks="_assetChecks" />
                    break;
                case DashboardView.Department:
                    <DepartmentDashboard Model="d" Charts="_charts!" Approvals="_waitingApprovals" AssetChecks="_assetChecks" />
                    break;
                default:
                    <CompanyDashboard Model="d" Charts="_charts!" Approvals="_waitingApprovals" AssetChecks="_assetChecks" />
                    break;
            }
        </div>
    }
}

@code {
    private const string ViewKey = "View";

    protected override string MemoryKey => "dashboard";
    protected override IReadOnlyList<string> FilterKeys => [ViewKey, nameof(DepartmentId)];

    /// <summary>The view, read as text and resolved leniently: a bad or unreachable one is the viewer's default (DashboardRules.Resolve).</summary>
    [SupplyParameterFromQuery(Name = ViewKey)] public string? ViewChoice { get; set; }
    /// <summary>The Department view's department, for someone who sees every department; ignored for anyone else.</summary>
    [SupplyParameterFromQuery] public string? DepartmentId { get; set; }

    private DashboardModel? _d;
    private DashboardCharts? _charts;
    /// <summary>The Asset checks card (§6.19), for a role with assets.check; null otherwise.</summary>
    private AssetCheckSummary? _assetChecks;
    /// <summary>The My waiting approvals card (§6.9, §6.20), for a role that can open requests; null otherwise.</summary>
    private IReadOnlyList<RequestActionItem>? _waitingApprovals;
    /// <summary>The side cards are the same on every view, so a view switch or department pick reloads the view only.</summary>
    private bool _sideLoaded;

    protected override async Task OnParametersSetAsync()
    {
        if (await GoToRememberedAsync(reset: false)) return;
        await Load(async s =>
        {
            var actor = await s.Get<IActorProvider>().GetAsync();
            var d = await s.Get<DashboardService>().BuildAsync(DashboardRules.Resolve(ViewChoice, actor), FilterChoice.Id(DepartmentId));
            if (!_sideLoaded)
            {
                _assetChecks = await s.Get<AssetService>().GetCheckSummaryAsync();
                _waitingApprovals = await s.Get<RequestService>().WaitingApprovalsAsync();
                _sideLoaded = true;
            }
            _charts = d.View is null ? null : DashboardCharts.For(d);
            _d = d;
        });
    }

    private static string ViewLabel(DashboardView view) => view switch
    {
        DashboardView.Mine => "My work",
        DashboardView.Department => "Department",
        _ => "Company"
    };

    private Task ViewPickedAsync(DashboardView view) => GoAsync(ViewKey, DashboardRules.Key(view));

    private Task DepartmentPickedAsync(Guid id) => GoAsync(nameof(DepartmentId), id == Guid.Empty ? null : id.ToString());

    private string DepartmentName(Guid id) => _d?.Departments.FirstOrDefault(d => d.Id == id)?.Name ?? "";
}
