@page "/Requests/Start/{Id:guid}"
@inherits OrbitComponentBase
@using Microsoft.Extensions.Options
@inject IOptions<AttachmentOptions> AttachmentOptions
@* Logging a request through a flow (spec §6.20): the start form's questions one at a time, a review, then the request is logged
   and its page opens. A flow with no start form just confirms. The idempotency key is made once per visit, so a double click
   logs the request once. *@

<PageTitle>@(_flow?.Title ?? "Log a request") - Orbit</PageTitle>

@if (Refusal is not null)
{
    <AccessDenied Message="@Refusal" />
}
else if (_flow is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    var f = _flow;
    var c = f.Category;
    <nav class="orbit-breadcrumbs" aria-label="breadcrumb">
        <a href="/Requests">Requests</a><span class="orbit-crumb-sep">/</span><a href="@($"/Requests/Category/{c.Id}")">@c.Title</a>
        <span class="orbit-crumb-sep">/</span><span aria-current="page">@f.Title</span>
    </nav>
    <div class="@($"request-heading {RequestIcons.ColourClass(c.Colour)}")">
        <span class="request-icon request-icon-sm"><RequestIcon Name="@c.Icon" Size="24" /></span>
        <div>
            <MudText Typo="Typo.h5" HtmlTag="h1">@f.Title</MudText>
            <div class="orbit-muted">@(string.IsNullOrWhiteSpace(f.Description) ? "" : $"{f.Description} · ")Goes to @c.Department.Name</div>
        </div>
    </div>

    <RequestWizard Fields="_fields" AssetTypes="_assetTypes" AssetChoices="_assetChoices" Limits="AttachmentOptions.Value" ShowSteps="true"
                   NoDepartmentNote="@(_hasDepartment ? null : "You aren't in a department, so nothing is offered here.")"
                   ReviewHeading="Check your request" SendText="Log request" SendingText="Logging..." Send="SendAsync">
        <ReviewIntro>It goes to <b>@c.Department.Name</b>. You can follow it under <i>Your requests</i> on the Requests page.</ReviewIntro>
        <NoQuestions>This request asks you nothing up front: log it, and @c.Department.Name takes it from there.</NoQuestions>
        <Aside>
            <section class="request-aside-section" aria-labelledby="request-next-heading">
                <h2 id="request-next-heading">What happens next</h2>
                @if (_later.Count > 0)
                {
                    <ol class="request-next">
                        @foreach (var s in _later) { <li>@s.Title</li> }
                    </ol>
                }
                else
                {
                    <p class="ma-0">@c.Department.Name takes it from there.</p>
                }
            </section>
        </Aside>
    </RequestWizard>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private RequestFlow? _flow;
    private IReadOnlyList<RequestFormField> _fields = [];
    private IReadOnlyList<RequestFlowStep> _later = [];
    private IReadOnlyDictionary<Guid, IReadOnlyList<RequestAssetTypeChoice>> _assetTypes = new Dictionary<Guid, IReadOnlyList<RequestAssetTypeChoice>>();
    private IReadOnlyDictionary<Guid, IReadOnlyList<RequestLookupItem>> _assetChoices = new Dictionary<Guid, IReadOnlyList<RequestLookupItem>>();
    private bool _hasDepartment;
    /// <summary>Made once per visit, so a double click or a retry logs the request once.</summary>
    private readonly string _idempotencyKey = Guid.NewGuid().ToString("N");

    protected override async Task OnParametersSetAsync() => await Load(async s =>
    {
        var requests = s.Get<RequestService>();
        var flow = await requests.FlowAsync(Id);
        var form = RequestFlowRules.StartForm(flow);
        if (form is not null)
        {
            _hasDepartment = (await s.Get<IActorProvider>().GetAsync()).DepartmentId is not null;
            _assetTypes = await requests.AssetTypeChoicesAsync(flow, form, null);
            _assetChoices = await requests.AssetChoicesAsync(flow, form, null);
            _fields = form.Fields.ToList();
        }
        _later = flow.Steps.Where(x => x.Id != form?.Id).ToList();
        _flow = flow;
    });

    private async Task<(string, string)> SendAsync(IServiceProvider s, IReadOnlyDictionary<Guid, RequestAnswerInput> answers,
        IReadOnlyDictionary<Guid, IReadOnlyList<AttachmentUpload>> files)
    {
        var request = await s.Get<RequestService>().StartAsync(Id, answers, files, _idempotencyKey);
        return ($"Request {request.Number} logged with {_flow!.Category.Department.Name}.", $"/Requests/Request/{request.Id}");
    }
}
