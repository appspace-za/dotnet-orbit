@page "/Admin/Nagios/Details/{Id:guid}"
@inherits OrbitComponentBase
@* One Nagios instance (spec §6.21): how it last answered, a warning when its agent is missing, offline or too old, the problems Orbit
   is watching on it - each with the task it raised, once it has - and the ones that ended lately (the last 50), with its settings.
   "Check now" queues a check in the Nagios job rather than running one here, so it never runs beside the scheduled one. *@

<PageTitle>@(_details?.Instance.Name ?? "Nagios") - Orbit</PageTitle>

@if (Refusal is not null)
{
    <AccessDenied Message="@Refusal" />
}
else if (_details is null || _details.Instance.Id != Id)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    var d = _details;
    var n = d.Instance;
    var raised = d.Open.Count(i => i.TaskId is not null);
    <nav class="orbit-breadcrumbs" aria-label="breadcrumb">
        <a href="/Admin/Nagios/Index">Nagios</a><span class="orbit-crumb-sep">/</span><span aria-current="page">@n.Name</span>
    </nav>
    <div class="orbit-page-header">
        <div>
            <MudText Typo="Typo.h5" HtmlTag="h1">@n.Name</MudText>
            <div class="orbit-subtitle orbit-break">@n.BaseUrl</div>
        </div>
        <div class="orbit-actions">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(_busy || !n.Enabled)"
                       title="@(n.Enabled ? null : "Switched off")" OnClick="CheckNowAsync">Check now</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Href="@($"/Admin/Nagios/Edit/{n.Id}")">Settings</MudButton>
        </div>
    </div>

    @if (n.Agent is null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">
            The agent this instance was checked through has been deleted, so nothing is checked. Choose another under
            <a href="@($"/Admin/Nagios/Edit/{n.Id}")">Settings</a>.
        </MudAlert>
    }
    else if (n.Enabled && !d.AgentOnline)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            Agent "@n.Agent.Name" isn't connected, so this instance can't be checked. Nothing is raised or resolved until it is back.
            <a href="/Admin/Agents/Index">Agents</a>
        </MudAlert>
    }
    else if (n.Enabled && !d.AgentQueriesNagios)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">Agent "@n.Agent.Name" is too old to read Nagios. Update it to version 1.3 or later.</MudAlert>
    }
    @if (n.HeldBack > 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            @n.HeldBack @(n.HeldBack == 1 ? "problem is" : "problems are") past the threshold but held back: at most @n.MaxNewTasksPerCheck new tasks
            are raised in one check. The rest follow on the next checks, longest down first.
        </MudAlert>
    }

    <MudGrid Spacing="3">
        <MudItem xs="12" lg="8">
            <MudPaper Outlined="true" Class="orbit-card">
                <div class="orbit-card-header">
                    <span><b>Problems Orbit is watching</b> <span class="orbit-muted">(@d.Open.Count, @raised with a task)</span></span>
                </div>
                @if (d.Open.Count == 0)
                {
                    <p class="orbit-empty">Nothing that counts towards a task right now.</p>
                }
                else
                {
                    <div class="orbit-table-wrap">
                        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="orbit-tasks">
                            <thead>
                                <tr><th>Host</th><th>Service</th><th>State</th><th>Since</th><th>Task</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var i in d.Open)
                                {
                                    <tr @key="i.Id">
                                        <td>@i.HostName</td>
                                        <td>
                                            @(i.IsService ? i.ServiceDescription : "-")
                                            @if (!string.IsNullOrEmpty(i.Output))
                                            {
                                                <div class="orbit-sub orbit-break">@Ui.Truncate(i.Output, 140)</div>
                                            }
                                        </td>
                                        <td><MudChip T="string" Size="Size.Small" Color="StatusLook.Nagios(i.State)">@i.State.Label()</MudChip></td>
                                        <td class="text-nowrap orbit-small">@Ui.When(i.ProblemSince)</td>
                                        <td class="orbit-small">
                                            @if (i.Task is not null)
                                            {
                                                <span class="orbit-gap-row">
                                                    <span class="orbit-key"><a href="@($"/Tasks/Details/{i.TaskId}")">@i.Task.Number</a></span>
                                                    <MudChip T="string" Size="Size.Small" Color="TaskLook.Status(i.Task.Status)">@i.Task.Status.Label()</MudChip>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="orbit-muted" title="@($"Its threshold is counted from {Ui.When(i.ClockFrom)}")">not raised</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </div>
                }
            </MudPaper>

            <MudPaper Outlined="true" Class="orbit-card">
                <div class="orbit-card-header"><b>Ended lately</b></div>
                @if (d.Recent.Count == 0)
                {
                    <p class="orbit-empty">None yet.</p>
                }
                else
                {
                    <div class="orbit-table-wrap">
                        <MudSimpleTable Dense="true" Elevation="0" Class="orbit-tasks">
                            <thead>
                                <tr><th>Host</th><th>Service</th><th>Was</th><th>From</th><th>Ended</th><th>Task</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var i in d.Recent)
                                {
                                    <tr @key="i.Id">
                                        <td>@i.HostName</td>
                                        <td>@(i.IsService ? i.ServiceDescription : "-")</td>
                                        <td><MudChip T="string" Size="Size.Small" Color="StatusLook.Nagios(i.State)">@i.State.Label()</MudChip></td>
                                        <td class="text-nowrap orbit-small">@Ui.When(i.ProblemSince)</td>
                                        <td class="text-nowrap orbit-small">
                                            @Ui.When(i.ResolvedAt)
                                            <div class="orbit-muted">@(i.Resolution?.Label())</div>
                                        </td>
                                        <td class="orbit-small">
                                            @if (i.Task is not null)
                                            {
                                                <span class="orbit-gap-row">
                                                    <span class="orbit-key"><a href="@($"/Tasks/Details/{i.TaskId}")">@i.Task.Number</a></span>
                                                    <MudChip T="string" Size="Size.Small" Color="TaskLook.Status(i.Task.Status)">@i.Task.Status.Label()</MudChip>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="orbit-muted">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </div>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="4">
            <MudPaper Outlined="true" Class="orbit-card">
                <div class="orbit-card-header"><b>Last check</b></div>
                <div class="orbit-card-body pb-0"><NagiosHealth Instance="n" /></div>
                <dl class="orbit-dl">
                    <dt>Last read</dt><dd>@Ui.When(n.LastSucceededAt)</dd>
                    <dt>Last asked</dt><dd>@Ui.When(n.LastAttemptAt)</dd>
                    <dt>Agent</dt><dd>@(n.Agent?.Name ?? "none")</dd>
                </dl>
            </MudPaper>
            <MudPaper Outlined="true" Class="orbit-card">
                <div class="orbit-card-header"><b>Settings</b></div>
                <dl class="orbit-dl">
                    <dt>Raises</dt><dd>@string.Join(", ", RaisedStates(n))</dd>
                    <dt>Hosts after</dt><dd>@n.HostThresholdMinutes min</dd>
                    <dt>Services after</dt><dd>@n.ServiceThresholdMinutes min</dd>
                    <dt>Downtime</dt><dd>@(n.SkipScheduledDowntime ? "not raised" : "raised")</dd>
                    <dt>Acknowledged</dt><dd>@(n.SkipAcknowledged ? "not raised" : "raised")</dd>
                    <dt>Checked every</dt><dd>@n.CheckIntervalMinutes min</dd>
                    <dt>Tasks go to</dt><dd>@n.Department.Name · @n.TaskPriority</dd>
                    <dt>Tasks due</dt><dd>@n.TaskDue.Label()</dd>
                    <dt>Signs in as</dt><dd>@n.Username@(d.HasPassword ? "" : " (no password stored)")</dd>
                </dl>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private NagiosInstanceDetails? _details;
    private bool _busy;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var id = Id;
        await Load(async s => _details = await s.Get<NagiosService>().DetailsAsync(id));
    }

    /// <summary>The states the instance raises tasks for, in the order the settings list them.</summary>
    private static List<string> RaisedStates(NagiosInstance n)
    {
        var states = new List<string>();
        if (n.RaiseHostDown) states.Add("host Down");
        if (n.RaiseHostUnreachable) states.Add("host Unreachable");
        if (n.RaiseServiceCritical) states.Add("service Critical");
        if (n.RaiseServiceWarning) states.Add("service Warning");
        if (n.RaiseServiceUnknown) states.Add("service Unknown");
        return states;
    }

    /// <summary>Queues a check in the Nagios job; the page is read again, as the Razor page redirected to itself.</summary>
    private async Task CheckNowAsync()
    {
        var id = Id;
        _busy = true;
        if (await Act(async s => await s.Get<NagiosService>().CheckNowAsync(id)))
        {
            Success("A check is on its way. Refresh in a few seconds to see what it found.");
            await LoadAsync();
        }
        _busy = false;
    }
}
