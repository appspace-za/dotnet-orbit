@* The dashboard's Active sprint card (spec §6.9): the sprint's work done against its time gone, so it shows at a glance whether
   it is on track. Sprints are shared company-wide (§6.3), so both are the whole sprint's; under them the view's part - each
   department's progress on the Company view, the view's tasks by status otherwise. *@
<MudPaper Outlined="true" Class="orbit-card">
    <div class="orbit-card-header"><b>Active sprint</b><a href="/Sprints" class="orbit-small">Sprints</a></div>
    @if (Model.ActiveSprint is not { } sprint)
    {
        <div class="orbit-list-item orbit-muted"><i>No sprint is active right now.</i></div>
    }
    else
    {
        var day = Model.SprintDay ?? new SprintDay(0, 1);
        // Cancelled tasks are left out of the work, so a sprint with nothing left open reaches 100% (decision 135).
        var workPct = Percentage.Of(Model.Sprint.Done, Model.Sprint.NotCancelled);
        <div class="orbit-card-body">
            <a href="@($"/Sprints/Board/{sprint.Id}")" class="orbit-sprint-name">@sprint.Name</a>
            <div class="orbit-muted orbit-small">@Ui.Day(sprint.StartDate) to @Ui.Day(sprint.EndDate) · day @day.Day of @day.Days</div>
            @if (!string.IsNullOrWhiteSpace(sprint.Goal))
            {
                <div class="mt-1">@sprint.Goal</div>
            }
            <div class="orbit-dash-meters mt-3">
                <span>Work done</span>
                <MudProgressLinear Value="workPct" Color="Color.Success" Rounded="true" Size="Size.Medium" aria-label="Work done" />
                <span class="orbit-muted" title="@(Model.Sprint.Cancelled > 0 ? $"{Model.Sprint.Cancelled} cancelled, left out" : null)">@Model.Sprint.Done / @Model.Sprint.NotCancelled (@workPct%)</span>
                <span>Time elapsed</span>
                <MudProgressLinear Value="day.Percent" Color="Color.Secondary" Rounded="true" Size="Size.Medium" aria-label="Time elapsed" />
                <span class="orbit-muted">@day.Percent%</span>
            </div>
        </div>
        @if (Model.View == DashboardView.Company)
        {
            @if (Model.SprintByDepartment.Count > 0)
            {
                <div class="orbit-card-footer">
                    <div class="orbit-dash-meters">
                        @foreach (var row in Model.SprintByDepartment)
                        {
                            var pct = Percentage.Of(row.Done, row.Total);
                            <span class="orbit-truncate" @key="row.Department">@row.Department</span>
                            <MudProgressLinear Value="pct" Color="Color.Success" Rounded="true" aria-label="@row.Department" />
                            <span>@row.Done / @row.Total</span>
                        }
                    </div>
                </div>
            }
        }
        else if (Model.SprintInScope.Total == 0)
        {
            <div class="orbit-card-footer">@(Model.View == DashboardView.Mine ? "None of your tasks are in this sprint." : "None of the department's tasks are in this sprint.")</div>
        }
        else
        {
            <div class="orbit-card-footer orbit-gap-row">
                <span>@(Model.View == DashboardView.Mine ? "Your tasks:" : "The department's tasks:")</span>
                <DashboardLegend Items="InScope(sprint.Id)" Row="true" />
            </div>
        }
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public DashboardModel Model { get; set; } = null!;

    private IReadOnlyList<DashboardSlice> InScope(Guid sprintId) =>
        DashboardLook.PlanOrder.Where(s => Model.SprintInScope.Of(s) > 0)
            .Select(s => new DashboardSlice(s.Label(), Model.SprintInScope.Of(s), DashboardLook.Status(s), Model.Links.InSprint(sprintId, s)))
            .ToList();
}
