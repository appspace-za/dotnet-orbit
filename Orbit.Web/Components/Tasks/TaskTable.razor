@* The shared task table (spec §6.2), which replaced the Razor _TaskRows partial with the same columns and rules. Rows
   the viewer may change get live controls that save at once, with no page reload; Changed tells the page to reload its data.
   Edits says which controls a page wants, and a page can add a class per row, its own Sprint cell and a column of row actions
   (the Planning page, §6.3, decision 141).
   Given a Tree instead of Tasks (the Tasks list and the project page, §6.15, decision 145), it draws each subtask under its parent,
   indented, with a toggle that collapses the branch (remembered in the browser, BrowserTreeMemory), greyed context rows without
   controls, and a parent's branch summary under its own values in each cell (BranchSummaryCell). *@
@if (Tree is not null && _collapsed is null)
{
    @* The collapsed parents are read from the browser before the first draw, so collapsed branches don't flash open. *@
}
else if (_rows.Count == 0)
{
    <p class="orbit-empty">@(EmptyMessage ?? "No tasks.")</p>
}
else
{
    @if (Tree is not null && Tree.Any(e => e.HasChildren))
    {
        <div class="orbit-tree-tools">
            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="() => SetAllAsync(false)">Expand all</MudButton>
            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="() => SetAllAsync(true)">Collapse all</MudButton>
        </div>
    }
    <div class="orbit-table-wrap">
        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="@(Class is null ? "orbit-tasks" : $"orbit-tasks {Class}")">
            <thead>
                <tr>
                    @if (Selectable)
                    {
                        <th class="orbit-check">
                            <MudCheckBox T="bool?" TriState="true" Value="AllSelected" ValueChanged="ToggleAllAsync" Size="Size.Small" Dense="true"
                                         aria-label="Select all" title="Select all" Disabled="Selectables.Count == 0" />
                        </th>
                    }
                    @if (ShowPlanToday)
                    {
                        <th class="orbit-today" title="On today's day plan">Today</th>
                    }
                    <th>Task</th>
                    @if (ShowProject) { <th>Project</th> }
                    @if (ShowDepartment) { <th>Department</th> }
                    <th>Priority</th>
                    @if (ShowAssignee) { <th>Assignee</th> }
                    <th>Due</th>
                    @if (ShowEstimate)
                    {
                        <th class="text-right" title="@(Logged is null ? "Estimated effort" : "Estimated effort, and what is left of it after the time logged")">Est.</th>
                    }
                    @if (ShowSprint) { <th>Sprint</th> }
                    <th>Status</th>
                    @if (RowActions is not null) { <th></th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var (t, entry) in _rows)
                {
                    @if (entry is { TitleOnly: true })
                    {
                        @* An ancestor the viewer can't open (§6.15): its number and title only, as the "in:" line used to show. *@
                        <tr @key="t.Id" class="orbit-context">
                            @if (Selectable) { <td class="orbit-check"></td> }
                            @if (ShowPlanToday) { <td class="orbit-today"></td> }
                            <td class="orbit-tree-td" style="@IndentStyle(entry)">
                                @Lead(entry)<span class="orbit-number" title="Task number">@t.Number</span><span class="orbit-title">@t.Title</span>
                            </td>
                            <td colspan="@ColumnsAfterTask"></td>
                        </tr>
                        continue;
                    }
                    var canView = AccessPolicy.CanViewTask(Actor, t);
                    var overdue = t.IsOverdue(Today);
                    var statuses = Ui.AllowedStatuses(Actor, t);
                    var canEdit = canView && AccessPolicy.CanEditTask(Actor, t);
                    var quickEdit = QuickEditAssignees is not null && canEdit;
                    var summary = entry?.Summary;
                    <tr @key="t.Id" class="@RowClasses(t, entry)">
                        @if (Selectable)
                        {
                            <td class="orbit-check">
                                @if (entry?.IsContext != true && AccessPolicy.CanPlanTask(Actor, t))
                                {
                                    var id = t.Id;
                                    <MudCheckBox T="bool" Value="Selected.Contains(id)" ValueChanged="v => ToggleAsync(id, v)" Size="Size.Small" Dense="true"
                                                 aria-label="@($"Select {t.Number}")" />
                                }
                            </td>
                        }
                        @if (ShowPlanToday)
                        {
                            <td class="orbit-today">
                                @if (Can(entry, TaskTableEdits.Today) && t.IsOpen && AccessPolicy.CanPlanTask(Actor, t))
                                {
                                    <PlanTodayToggle Task="t" Today="Today" Changed="Changed" />
                                }
                                else if (t.PlannedFor == Today)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" title="Was on today's plan">Today</MudChip>
                                }
                            </td>
                        }
                        <td class="@(entry is null ? null : "orbit-tree-td")" style="@IndentStyle(entry)">
                            @if (entry is not null)
                            {
                                @Lead(entry)
                            }
                            <span class="orbit-number" title="Task number">@t.Number</span>
                            @if (canView)
                            {
                                <a href="@($"/Tasks/Details/{t.Id}")" target="@(NewTab ? "_blank" : null)" class="@(overdue ? "orbit-title orbit-overdue" : "orbit-title")">@t.Title</a>
                            }
                            else
                            {
                                <span class="orbit-title">@t.Title</span>
                            }
                            @if (summary is not null)
                            {
                                <span class="orbit-branch-count" title="Subtasks in its branch">(@summary.SubtaskCount)</span>
                            }
                            @if (t.Type != TaskType.Task)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="TaskLook.Type(t.Type)" Class="@TaskLook.TypeClass(t.Type)" title="Type">@t.Type</MudChip>
                            }
                            @if (t.Source != TaskSource.Manual)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="TaskLook.Source(t.Source)" Class="@TaskLook.SourceClass(t.Source)">@Ui.SourceLabel(t.Source)</MudChip>
                            }
                            @if (Waiting is not null && Waiting.TryGetValue(t.Id, out var waiting))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" title="@waiting.Reason">Gated</MudChip>
                            }
                            @if (CarryOvers is not null && CarryOvers.TryGetValue(t.Id, out var carried))
                            {
                                <MudChip T="string" Size="Size.Small" Variant="@(carried >= DayPlanRules.RepeatedCarryOvers ? Variant.Filled : Variant.Outlined)"
                                         Color="@(carried >= DayPlanRules.RepeatedCarryOvers ? Color.Error : Color.Default)"
                                         title="@($"Carried over to a later day's plan {carried} time{(carried == 1 ? "" : "s")}")">Carried over @(carried)&times;</MudChip>
                            }
                            @if (t.ParentTask is not null && Tree is null)
                            {
                                <div class="orbit-sub" title="Subtask of @t.ParentTask.Title">in: @Ui.Truncate(t.ParentTask.Title, 60)</div>
                            }
                            @if (t.Asset is not null)
                            {
                                <div class="orbit-sub" title="The asset this task is about">asset: @Ui.Truncate(Ui.AssetLabel(t.Asset), 60)</div>
                            }
                        </td>
                        @if (ShowProject)
                        {
                            <td>
                                @if (t.Project is not null)
                                {
                                    <MudLink Href="@($"/Projects/Details/{t.ProjectId}")" Target="@(NewTab ? "_blank" : null)" Underline="Underline.Hover">@t.Project.Name</MudLink>
                                }
                                else
                                {
                                    <span class="orbit-muted">-</span>
                                }
                            </td>
                        }
                        @if (ShowDepartment)
                        {
                            <td><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@t.Department?.Name</MudChip></td>
                        }
                        <td>
                            <MudChip T="string" Size="Size.Small" Color="TaskLook.Priority(t.Priority)"
                                     Variant="@(t.Priority == TaskPriority.Low ? Variant.Outlined : Variant.Filled)">@t.Priority</MudChip>
                            @if (summary is not null) { <BranchSummaryCell Summary="summary" Column="BranchColumn.Priority" /> }
                        </td>
                        @if (ShowAssignee)
                        {
                            var assignees = t.Assignees;
                            <td>
                                @if (assignees.Count > 1)
                                {
                                    @* Several assignees (§6.2.3) are shown, not edited here: the task page and the edit form change them. *@
                                    foreach (var u in assignees)
                                    {
                                        <div class="orbit-sub">@u.DisplayName</div>
                                    }
                                }
                                else if (quickEdit && Can(entry, TaskTableEdits.Assignee))
                                {
                                    <TaskAssigneeSelect Task="t" Candidates="CandidatesFor(t)" Changed="Changed" />
                                }
                                else if (Can(entry, TaskTableEdits.Take) && AccessPolicy.CanTakeTask(Actor, t))
                                {
                                    <TakeButton Task="t" Changed="Changed" />
                                }
                                else
                                {
                                    @(t.AssigneeNames ?? "-")
                                }
                                @if (summary is not null) { <BranchSummaryCell Summary="summary" Column="BranchColumn.Assignee" /> }
                            </td>
                        }
                        <td class="@(overdue ? "orbit-overdue" : null)">
                            @if (quickEdit && Can(entry, TaskTableEdits.DueDate))
                            {
                                <TaskDueDatePicker Task="t" Today="Today" Changed="Changed" />
                            }
                            else
                            {
                                @Ui.Day(t.DueDate)@(overdue ? " (overdue)" : "")
                            }
                            @if (summary is not null) { <BranchSummaryCell Summary="summary" Column="BranchColumn.Due" /> }
                        </td>
                        @if (ShowEstimate)
                        {
                            <td class="text-right text-nowrap">
                                @if (quickEdit && Can(entry, TaskTableEdits.Estimate))
                                {
                                    <TaskEstimateField Task="t" Changed="Changed" />
                                }
                                else if (t.EstimateMinutes is int estimate) { @TimeFormat.Minutes(estimate) } else { <span class="orbit-muted" title="No estimate">-</span> }
                                @if (Logged?.GetValueOrDefault(t.Id) is int logged and > 0 && t.EstimateMinutes is not null)
                                {
                                    <div class="orbit-sub" title="@($"{TimeFormat.Minutes(logged)} logged so far")">@TimeFormat.Minutes(SprintPlanningRules.Remaining(t, logged)) left</div>
                                }
                                @if (summary is not null) { <BranchSummaryCell Summary="summary" Column="BranchColumn.Estimate" /> }
                            </td>
                        }
                        @if (ShowSprint)
                        {
                            <td>
                                @if (SprintCell is not null)
                                {
                                    @SprintCell(t)
                                }
                                else if (Can(entry, TaskTableEdits.Sprint) && QuickEditSprints is not null && canView && t.IsOpen && AccessPolicy.CanPlanTask(Actor, t))
                                {
                                    <TaskSprintSelect Task="t" Sprints="QuickEditSprints" Changed="Changed" />
                                }
                                else if (t.Sprint is not null)
                                {
                                    <MudLink Href="@($"/Sprints/Details/{t.SprintId}")" Target="@(NewTab ? "_blank" : null)" Underline="Underline.Hover">@t.Sprint.Name</MudLink>
                                }
                                else
                                {
                                    <span class="orbit-muted">@SprintPlacement.Of(t).Label()</span>
                                }
                                @if (summary is not null) { <BranchSummaryCell Summary="summary" Column="BranchColumn.Sprint" /> }
                            </td>
                        }
                        <td>
                            @if (Can(entry, TaskTableEdits.Status) && canView && statuses.Count > 1)
                            {
                                <TaskStatusSelect Task="t" Statuses="statuses" Branch="summary" Changed="Changed" />
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="TaskLook.Status(t.Status)">@t.Status.Label()</MudChip>
                            }
                            @if (summary is not null) { <BranchSummaryCell Summary="summary" Column="BranchColumn.Status" /> }
                        </td>
                        @if (RowActions is not null)
                        {
                            <td class="text-right text-nowrap">@RowActions(t)</td>
                        }
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </div>
}

@code {
    [Inject] private BrowserTreeMemory TreeMemory { get; set; } = null!;

    /// <summary>The rows, flat, in the order given. A page passes these or <see cref="Tree"/>.</summary>
    [Parameter] public IReadOnlyList<TaskItem> Tasks { get; set; } = [];
    /// <summary>
    /// The rows as a tree (§6.15, decision 145), in display order: each subtask under its parent, indented, with a collapse toggle,
    /// greyed context rows without controls, and the branch summary under a parent's own values. Takes the place of <see cref="Tasks"/>.
    /// </summary>
    [Parameter] public IReadOnlyList<TaskTreeEntry>? Tree { get; set; }
    [Parameter, EditorRequired] public Actor Actor { get; set; } = null!;
    [Parameter] public DateOnly Today { get; set; } = DateOnly.FromDateTime(DateTime.UtcNow);

    /// <summary>
    /// When set, rows the actor may edit get the assignee and due-date controls, and the estimate control where
    /// <see cref="ShowEstimate"/> is on, as far as <see cref="Edits"/> allows. Candidates are narrowed per row to the task's
    /// department plus anyone who sees every department. Null leaves those cells read-only.
    /// </summary>
    [Parameter] public IReadOnlyList<UserSummary>? QuickEditAssignees { get; set; }
    /// <summary>When set (with <see cref="ShowSprint"/>), open rows the actor may plan get the sprint control (§6.3).</summary>
    [Parameter] public IReadOnlyList<Sprint>? QuickEditSprints { get; set; }

    /// <summary>
    /// Every cell as text, for a page that shows tasks rather than changes them (the Today page, §6.12): no status, assignee, due-date,
    /// estimate or sprint control, no Take button and no Today tick. A <see cref="Selectable"/> checkbox still shows.
    /// The same as <see cref="Edits"/> None.
    /// </summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Which live controls the rows may have (all by default); each still needs the actor's right and its data.</summary>
    [Parameter] public TaskTableEdits Edits { get; set; } = TaskTableEdits.All;

    [Parameter] public bool ShowPlanToday { get; set; }
    [Parameter] public bool ShowProject { get; set; } = true;
    [Parameter] public bool ShowDepartment { get; set; } = true;
    [Parameter] public bool ShowSprint { get; set; }
    [Parameter] public bool ShowAssignee { get; set; } = true;
    [Parameter] public bool ShowEstimate { get; set; }

    /// <summary>All the time logged on each task so far: when set, the Est. cell adds what is left of the estimate (§6.10).</summary>
    [Parameter] public IReadOnlyDictionary<Guid, int>? Logged { get; set; }

    /// <summary>Task, project and sprint links open in a new tab, so a page with state to keep (the Planning page) stays put.</summary>
    [Parameter] public bool NewTab { get; set; }

    /// <summary>A class added to the table, beside orbit-tasks.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>A class for a task's row, or null for none.</summary>
    [Parameter] public Func<TaskItem, string?>? RowClass { get; set; }
    /// <summary>The Sprint cell's content in place of the sprint control or link (with <see cref="ShowSprint"/>).</summary>
    [Parameter] public RenderFragment<TaskItem>? SprintCell { get; set; }
    /// <summary>A last column of buttons for each row.</summary>
    [Parameter] public RenderFragment<TaskItem>? RowActions { get; set; }

    /// <summary>A checkbox on each row the actor may plan, collected in <see cref="Selected"/>.</summary>
    [Parameter] public bool Selectable { get; set; }
    [Parameter] public HashSet<Guid> Selected { get; set; } = [];
    [Parameter] public EventCallback SelectionChanged { get; set; }

    /// <summary>Tasks whose next move is gated by a dependency (§6.15), for the Gated chip.</summary>
    [Parameter] public IReadOnlyDictionary<Guid, WaitingSummary>? Waiting { get; set; }
    /// <summary>How often each task has been carried over on the day plan (§6.12), for the Carried over chip.</summary>
    [Parameter] public IReadOnlyDictionary<Guid, int>? CarryOvers { get; set; }
    [Parameter] public string? EmptyMessage { get; set; }

    /// <summary>Raised after a row's control changed its task.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    /// <summary>The assignee candidates for each department's rows, worked out once for the parameters given.</summary>
    private readonly Dictionary<Guid, IReadOnlyList<UserSummary>> _candidates = [];

    /// <summary>The parents collapsed in the tree, read from the browser once a <see cref="Tree"/> is given; null until then.</summary>
    private HashSet<Guid>? _collapsed;
    /// <summary>The rows drawn: every task in flat mode; in tree mode the entries no collapsed parent hides.</summary>
    private List<(TaskItem Task, TaskTreeEntry? Entry)> _rows = [];

    protected override async Task OnParametersSetAsync()
    {
        _candidates.Clear();
        if (Tree is not null && _collapsed is null)
        {
            try
            {
                _collapsed = await TreeMemory.CollapsedAsync();
            }
            catch (JSException)
            {
                _collapsed = []; // storage unreadable: every parent expanded, as for a first visit
            }
        }
        Redraw();
    }

    private void Redraw()
    {
        if (Tree is null)
        {
            _rows = Tasks.Select(t => (t, (TaskTreeEntry?)null)).ToList();
            return;
        }
        var hidden = TaskTreeRules.Hidden(Tree.Select(e => (e.Task.Id, e.Depth)).ToList(), _collapsed ?? new HashSet<Guid>());
        _rows = Tree.Where(e => !hidden.Contains(e.Task.Id)).Select(e => (e.Task, (TaskTreeEntry?)e)).ToList();
    }

    private bool Allows(TaskTableEdits edit) => !ReadOnly && Edits.HasFlag(edit);

    /// <summary>A row's live control: as <see cref="Allows"/>, but never on a tree's context row, which is shown for its place only.</summary>
    private bool Can(TaskTreeEntry? entry, TaskTableEdits edit) => Allows(edit) && entry?.IsContext != true;

    private string? RowClasses(TaskItem t, TaskTreeEntry? entry)
    {
        var own = RowClass?.Invoke(t);
        return entry?.IsContext == true ? (own is null ? "orbit-context" : $"{own} orbit-context") : own;
    }

    private static string? IndentStyle(TaskTreeEntry? entry) =>
        entry is null ? null : $"--orbit-indent: {TaskTreeRules.Indent(entry.Depth)}";

    /// <summary>The cells after the Task cell, which a title-only row leaves blank in one.</summary>
    private int ColumnsAfterTask =>
        (ShowProject ? 1 : 0) + (ShowDepartment ? 1 : 0) + 1 + (ShowAssignee ? 1 : 0) + 1 + (ShowEstimate ? 1 : 0)
        + (ShowSprint ? 1 : 0) + 1 + (RowActions is not null ? 1 : 0);

    /// <summary>The toggle before a parent's number, or a space of its width so titles line up.</summary>
    private RenderFragment Lead(TaskTreeEntry entry) => entry.HasChildren
        ? @<MudIconButton Icon="@(IsCollapsed(entry) ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ExpandMore)"
                          Size="Size.Small" Class="orbit-tree-toggle" OnClick="() => ToggleBranchAsync(entry.Task.Id)"
                          aria-label="@($"{(IsCollapsed(entry) ? "Expand" : "Collapse")} {entry.Task.Number}")"
                          title="@($"{(IsCollapsed(entry) ? "Expand" : "Collapse")} {entry.Task.Number}")" />
        : @<span class="orbit-tree-spacer"></span>;

    private bool IsCollapsed(TaskTreeEntry entry) => _collapsed?.Contains(entry.Task.Id) == true;

    private async Task ToggleBranchAsync(Guid id)
    {
        if (_collapsed is null) return;
        var collapse = _collapsed.Add(id);
        if (!collapse) _collapsed.Remove(id);
        Redraw();
        await TreeMemory.SetAsync([id], collapse);
    }

    /// <summary>Expand all or Collapse all: every parent in this tree (one page of the Tasks list), and no other.</summary>
    private async Task SetAllAsync(bool collapse)
    {
        if (Tree is null || _collapsed is null) return;
        var ids = Tree.Where(e => e.HasChildren).Select(e => e.Task.Id).ToList();
        if (collapse) _collapsed.UnionWith(ids);
        else _collapsed.ExceptWith(ids);
        Redraw();
        await TreeMemory.SetAsync(ids, collapse);
    }

    private List<Guid> Selectables => _rows.Select(r => r.Task).Where(t => AccessPolicy.CanPlanTask(Actor, t)).Select(t => t.Id).ToList();

    private bool? AllSelected
    {
        get
        {
            var ids = Selectables;
            var picked = ids.Count(Selected.Contains);
            return picked == 0 ? false : picked == ids.Count ? true : null;
        }
    }

    private IReadOnlyList<UserSummary> CandidatesFor(TaskItem t)
    {
        if (!_candidates.TryGetValue(t.DepartmentId, out var list))
            _candidates[t.DepartmentId] = list = QuickEditAssignees!.Where(u => u.DepartmentId == t.DepartmentId || u.CanViewAllTasks).ToList();
        return list;
    }

    private async Task ToggleAsync(Guid id, bool selected)
    {
        if (selected) Selected.Add(id);
        else Selected.Remove(id);
        await SelectionChanged.InvokeAsync();
    }

    private async Task ToggleAllAsync(bool? _)
    {
        var ids = Selectables;
        if (ids.All(Selected.Contains)) Selected.ExceptWith(ids);
        else Selected.UnionWith(ids);
        await SelectionChanged.InvokeAsync();
    }
}
