@using Orbit.Pages.RequestCatalogue
@using Orbit.Application.Requests
@model FlowBadgesVm
@* A flow's state (spec §6.20), on the category's list and the flow's page. Archived says it all; otherwise Off and Not set up, either or both. *@
@{
    var f = Model.Flow;
    var size = Model.Large ? " fs-6 align-middle" : "";
}
@if (f.IsArchived)
{
    <span class="badge text-bg-secondary@(size)">Archived</span>
}
else
{
    if (!f.IsEnabled)
    {
        <span class="badge text-bg-secondary@(size)" title="Switched off: not offered until someone switches it on">Off</span>
    }
    if (!RequestFlowRules.IsReady(f))
    {
        <span class="badge text-bg-warning@(size)" title="A flow is offered once it has at least one step and every step is set up">Not set up</span>
    }
}
