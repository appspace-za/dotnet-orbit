@page
@model Orbit.Pages.Admin.Users.ImportModel
@using Orbit.Application.Services
@{
    ViewData["Title"] = "Import from directory";
    var s = Model.Setup;
    var p = Model.Preview;
    var o = Model.Outcome;
    var mo = Model.ManagersOutcome;
    var q = Model.Query;
    var selected = Model.SelectedKeys;
    var tickedManagers = Model.TickedManagers;
    var emailSource = p?.EmailSource ?? s.EmailSource;

    // Who an import or an update left out, and why: the same table in both results.
    void Skipped(IReadOnlyList<SkippedUser> skipped)
    {
        if (skipped.Count == 0) return;
        <details open>
            <summary class="small fw-semibold">Skipped</summary>
            <div class="table-responsive mt-2" style="max-height:24rem">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light"><tr><th>Name</th><th>Email</th><th>Why</th></tr></thead>
                    <tbody>
                        @foreach (var u in skipped)
                        {
                            <tr><td>@u.DisplayName</td><td>@(u.Email ?? "-")</td><td>@u.Reason</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    }
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-page="/Admin/Users/Index">Users</a></li>
        <li class="breadcrumb-item active" aria-current="page">Import from directory</li>
    </ol>
</nav>
<div class="mb-3">
    <h1 class="h3 mb-0">Import from directory</h1>
    <div class="text-muted small">Creates Orbit accounts for people in your company directory (Active Directory), who then sign in with their directory password. An <a asp-page="/Admin/Agents/Index">Orbit Agent</a> reads the directory; you choose who is imported, their role and their department, and each person gets the manager the directory names when that manager is in Orbit. People already in Orbit whose manager differs from the directory's are listed for you to update. Nothing happens by itself: Orbit follows the directory only when you do it here.</div>
</div>

@if (!s.DirectoryEnabled)
{
    <div class="alert alert-warning">
        <span class="fw-semibold">Directory sign-in isn't enabled.</span>
        Imported people sign in with it, so set it up under <a asp-page="/Admin/Directory/Index">Admin &gt; Directory</a> first.
    </div>
}
else if (s.AgentsAbleToList == 0)
{
    <div class="alert alert-warning">
        @if (s.AgentsConnected == 0)
        {
            <span class="fw-semibold">No Orbit Agent is connected,</span> <text>so there is nothing inside the network to read the directory.</text>
        }
        else
        {
            <span class="fw-semibold">The connected Orbit Agent@(s.AgentsConnected == 1 ? " is" : "s are") too old to list directory users.</span> <text>Update @(s.AgentsConnected == 1 ? "it" : "them") to version 1.1 or later; sign-in keeps working meanwhile.</text>
        }
        <a asp-page="/Admin/Agents/Index">Manage agents</a>
    </div>
}
else if (s.AgentsAbleToReadManagers == 0)
{
    <div class="alert alert-info">
        <span class="fw-semibold">Managers aren't read.</span>
        The connected Orbit Agent@(s.AgentsAbleToList == 1 ? " is" : "s are") older than version 1.4, so people are imported without a manager and managers can't be updated from the directory. Everything else on this page works as before.
        <a asp-page="/Admin/Agents/Index">Manage agents</a>
    </div>
}

@if (ViewData.ModelState[string.Empty]?.Errors.Count > 0)
{
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>
}

@if (o is not null)
{
    <div class="card mb-3">
        <div class="card-header fw-semibold">
            @(o.Imported.Count == 0 ? "Nobody was imported" : $"Imported {People(o.Imported.Count)} as {o.RoleName}")@(o.Skipped.Count == 0 ? "" : $", {o.Skipped.Count} skipped")
        </div>
        <div class="card-body">
            @if (o.Imported.Count > 0)
            {
                <p class="small mb-2">They can sign in now with their directory email and password. Each account is recorded in the activity log as imported from the directory.</p>
                @if (!o.ManagersRead && s.AgentsAbleToReadManagers > 0)
                {
                    <p class="small text-warning-emphasis mb-2">Their managers weren't read: the agent that answered this time is older than version 1.4. Load the directory again and set them with <span class="fw-semibold">Update ticked managers</span>.</p>
                }
                <details class="mb-2" open="@(o.Imported.Count <= 20)">
                    <summary class="small fw-semibold">Imported</summary>
                    <div class="table-responsive mt-2" style="max-height:24rem">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light"><tr><th>Name</th><th>Email</th><th>Department</th>@if (o.ManagersRead) { <th>Manager</th> }</tr></thead>
                            <tbody>
                                @foreach (var u in o.Imported)
                                {
                                    <tr>
                                        <td><a asp-page="/Admin/Users/Edit" asp-route-id="@u.Id">@u.DisplayName</a></td><td>@u.Email</td><td>@(u.DepartmentName ?? "-")</td>
                                        @if (o.ManagersRead)
                                        {
                                            <td>
                                                @(u.ManagerName ?? "-")
                                                @if (u.ManagerNote is not null) { <span class="small text-muted">(@u.ManagerNote)</span> }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }
            @{ Skipped(o.Skipped); }
        </div>
    </div>
}

@if (mo is not null)
{
    <div class="card mb-3">
        <div class="card-header fw-semibold">
            @(mo.Updated.Count == 0 ? "No manager was changed" : $"Changed the manager of {People(mo.Updated.Count)}")@(mo.Skipped.Count == 0 ? "" : $", {mo.Skipped.Count} skipped")
        </div>
        <div class="card-body">
            @if (mo.Updated.Count > 0)
            {
                <p class="small mb-2">Each change is recorded in the activity log as made from the directory. Nobody was signed out.</p>
                <details class="mb-2" open="@(mo.Updated.Count <= 20)">
                    <summary class="small fw-semibold">Changed</summary>
                    <div class="table-responsive mt-2" style="max-height:24rem">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light"><tr><th>Name</th><th>Manager was</th><th>Manager is now</th></tr></thead>
                            <tbody>
                                @foreach (var u in mo.Updated)
                                {
                                    <tr><td><a asp-page="/Admin/Users/Edit" asp-route-id="@u.UserId">@u.DisplayName</a></td><td>@(u.FromName ?? "-")</td><td>@u.ToName</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }
            @{ Skipped(mo.Skipped); }
        </div>
    </div>
}

<div class="card mb-3">
    <div class="card-header fw-semibold">Who to list</div>
    <div class="card-body">
        <form method="post" asp-page-handler="Load">
            <input type="hidden" name="RoleId" value="@Model.RoleId" />
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label" for="Query_Filter">Filter</label>
                    <input class="form-control key-box" id="Query_Filter" name="Query.Filter" value="@q.Filter" maxlength="@DirectoryImportRules.MaxFilterLength" />
                    <div class="form-text">An LDAP filter. The default is your sign-in filter with <code>*</code> in place of <code>{0}</code>, so it lists the people who could sign in. To import one group, add e.g. <code>(memberOf=CN=Finance,OU=Groups,DC=corp,DC=example,DC=com)</code> inside the <code>(&amp;...)</code>.</div>
                </div>
                <div class="col-md-8">
                    <label class="form-label" for="Query_SearchBase">Search base</label>
                    <input class="form-control" id="Query_SearchBase" name="Query.SearchBase" value="@q.SearchBase" maxlength="@DirectoryImportRules.MaxSearchBaseLength" placeholder="(the search base under Admin > Directory)" />
                    <div class="form-text">Narrow it to one OU to import a part of the organisation at a time.</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="Query_DepartmentAttribute">Department attribute</label>
                    <input class="form-control" id="Query_DepartmentAttribute" name="Query.DepartmentAttribute" value="@q.DepartmentAttribute" maxlength="64" placeholder="department" />
                    <div class="form-text">Matched to Orbit department names, ignoring case and spacing.</div>
                </div>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-3 mt-3">
                <button type="submit" class="btn btn-primary">Load directory users</button>
                <span class="small text-muted">Reads up to @DirectoryImportService.MaxUsers.ToString("N0") entries. Nothing is created until you import.</span>
            </div>
        </form>
    </div>
</div>

@if (p is not null)
{
    var linked = p.Rows.Count(r => r.CanImport && r.IsLinked);
    var changing = p.ManagerChanges.ToDictionary(c => c.UserId);
    <div class="d-flex flex-wrap gap-2 mb-3 small">
        <span class="badge text-bg-light border">@p.Rows.Count found@(p.AgentName is null ? "" : $" by agent \"{p.AgentName}\"")</span>
        <span class="badge text-bg-success">@p.ReadyCount ready to import</span>
        @if (p.ReadyCount > 0)
        {
            <span class="badge text-bg-light border">@linked linked to a department</span>
            @if (p.UnlinkedCount > 0) { <span class="badge text-bg-warning">@p.UnlinkedCount not linked</span> }
        }
        <span class="badge text-bg-secondary">@p.InOrbitCount already in Orbit</span>
        @if (p.ManagerChanges.Count > 0) { <span class="badge text-bg-info">@p.ManagerChanges.Count with another manager in the directory</span> }
        @if (p.BlockedCount > 0) { <span class="badge text-bg-secondary">@p.BlockedCount can't be imported</span> }
    </div>
    @if (p.Truncated)
    {
        <div class="alert alert-warning py-2">The directory has more entries than the @DirectoryImportService.MaxUsers.ToString("N0") read. Narrow the filter or the search base, and import in parts. A manager among the entries not read shows as "Not in this list".</div>
    }
    @if (!p.ManagersRead && s.AgentsAbleToReadManagers > 0)
    {
        <div class="alert alert-warning py-2">Agent "@p.AgentName" answered this time, and it is older than version 1.4, so managers weren't read. Load the directory again to ask a newer agent.</div>
    }
    <p class="small text-muted">
        Emails come from each person's <code>@emailSource.Attribute</code> attribute, the one your sign-in filter looks people up by.
        @if (emailSource.Warning is not null) { <span class="text-warning-emphasis d-block">@emailSource.Warning</span> }
    </p>

    @* One form with two actions, so that either keeps what was ticked and chosen for the other. Each button asks its own
       question (data-confirm on the button, site.js) and Update names its own handler; the form's is the import's. *@
    <form method="post" asp-page-handler="Import" id="importForm">
        @* The query travels with the form, so both actions read the directory exactly as it was listed. *@
        <input type="hidden" name="Query.Filter" value="@p.Query.Filter" />
        <input type="hidden" name="Query.SearchBase" value="@p.Query.SearchBase" />
        <input type="hidden" name="Query.DepartmentAttribute" value="@p.Query.DepartmentAttribute" />

        @if (p.ManagerChanges.Count > 0)
        {
            <div class="card border-info mb-3">
                <div class="card-header d-flex flex-wrap align-items-center gap-2">
                    <span class="fw-semibold">Managers that differ from the directory</span>
                    <input type="search" class="form-control form-control-sm js-table-filter" data-filter-target="#managerChanges" placeholder="Filter by name..." style="max-width:16rem" aria-label="Filter the managers" />
                    <span class="small text-muted"><span class="js-selected-count" data-count-of="#managerChanges">@p.ManagerChanges.Count(c => tickedManagers.Contains(c.Tick))</span> ticked</span>
                    <button type="submit" asp-page-handler="Managers" class="btn btn-primary btn-sm ms-auto" data-confirm="Change the manager of the ticked people to the one the directory names?">Update ticked managers</button>
                </div>
                <div class="card-body p-0">
                    <p class="small text-muted px-3 pt-3 mb-2">These people are already in Orbit, and the directory names another manager for them who is in Orbit too. Tick the ones to change. Nobody else is touched: a manager the directory leaves blank, or names but Orbit can't match, never removes one set in Orbit.</p>
                    <div class="table-responsive" style="max-height:28rem">
                        <table class="table table-sm table-hover align-middle mb-0" id="managerChanges">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:2rem"><input type="checkbox" class="form-check-input js-select-all" title="Tick everyone shown" aria-label="Tick all managers" /></th>
                                    <th>Person</th><th>Manager in Orbit</th><th>Manager in the directory</th><th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in p.ManagerChanges)
                                {
                                    <tr>
                                        <td><input type="checkbox" class="form-check-input js-select-item" name="ManagerTicks" value="@c.Tick" checked="@tickedManagers.Contains(c.Tick)" aria-label="Change the manager of @c.DisplayName" /></td>
                                        <td>
                                            <a asp-page="/Admin/Users/Edit" asp-route-id="@c.UserId">@c.DisplayName</a>
                                            <div class="small text-muted">@c.Email</div>
                                        </td>
                                        <td>
                                            @(c.CurrentManagerName ?? "-")
                                            @if (c.CurrentManagerInactive) { <span class="text-muted">(deactivated)</span> }
                                        </td>
                                        <td>@c.ManagerName</td>
                                        <td>
                                            @if (c.Kind == ManagerChangeKind.Set) { <span class="badge text-bg-light border">Sets a manager</span> }
                                            else { <span class="badge text-bg-warning">Replaces</span> }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @if (p.Unlinked.Count > 0)
        {
            <div class="card mb-3 border-warning">
                <div class="card-header fw-semibold">Departments that couldn't be linked</div>
                <div class="card-body">
                    <p class="small text-muted">No Orbit department has these names. Choose one for each, or leave them without a department (which the role must allow). This applies to this import only; to link them automatically next time, rename the Orbit department to match or <a asp-page="/Admin/Departments/Index">add it</a>.</p>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light"><tr><th>In the directory</th><th class="text-end">People</th><th style="min-width:16rem">Orbit department</th></tr></thead>
                            <tbody>
                                @for (var i = 0; i < p.Unlinked.Count; i++)
                                {
                                    var u = p.Unlinked[i];
                                    var mapped = Model.MappedTo(u.Key);
                                    <tr>
                                        <td>
                                            @if (u.IsBlank) { <span class="fst-italic">(no department in the directory)</span> } else { @u.Value }
                                            @if (u.ArchivedMatch is not null) { <div class="small text-muted">Matches the archived department "@u.ArchivedMatch".</div> }
                                        </td>
                                        <td class="text-end">@u.Count</td>
                                        <td>
                                            <input type="hidden" name="Map[@i].Key" value="@u.Key" />
                                            <select class="form-select form-select-sm" name="Map[@i].DepartmentId" aria-label="Orbit department for @(u.IsBlank ? "people with no department" : u.Value)">
                                                <option value="">(leave without a department)</option>
                                                @foreach (var d in Model.Departments)
                                                {
                                                    <option value="@d.Id" selected="@(mapped == d.Id)">@d.Name</option>
                                                }
                                            </select>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <div class="card">
            <div class="card-header d-flex flex-wrap align-items-center gap-2">
                <input type="search" class="form-control form-control-sm js-table-filter" data-filter-target="#directoryUsers" placeholder="Filter by name, email, department..." style="max-width:20rem" aria-label="Filter the list" />
                <span class="small text-muted"><span class="js-selected-count" data-count-of="#directoryUsers">@selected.Count</span> ticked</span>
                <div class="ms-auto d-flex flex-wrap align-items-center gap-2">
                    <label class="small" for="RoleId">Role</label>
                    <select class="form-select form-select-sm w-auto" id="RoleId" name="RoleId">
                        @foreach (var r in Model.RoleItems)
                        {
                            <option value="@r.Id" title="@r.Description" selected="@(r.Id == Model.RoleId)">@r.Name@(r.RequiresDepartment ? " (needs a department)" : "")</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-primary btn-sm" disabled="@(p.ReadyCount == 0)" data-confirm="Create Orbit accounts for the ticked people?">Import ticked</button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="directoryUsers">
                        <thead class="table-light">
                            <tr>
                                <th style="width:2rem"><input type="checkbox" class="form-check-input js-select-all" title="Tick everyone shown who can be imported" aria-label="Tick all" /></th>
                                <th>Name</th><th>Email</th><th>Account</th><th>Directory department</th><th>Orbit department</th>
                                @if (p.ManagersRead) { <th>Manager in the directory</th> }
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in p.Rows)
                            {
                                <tr class="@(r.CanImport ? "" : "text-muted")">
                                    <td>
                                        @if (r.CanImport)
                                        {
                                            <input type="checkbox" class="form-check-input js-select-item" name="Selected" value="@r.Key" checked="@selected.Contains(r.Key)" aria-label="Import @r.DisplayName" />
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@r.DisplayName</div>
                                        @if (r.Title is not null) { <div class="small text-muted">@r.Title</div> }
                                    </td>
                                    <td>@(r.Email ?? "-")</td>
                                    <td class="small">@(r.Account ?? "-")</td>
                                    <td>@(r.DirectoryDepartment ?? "-")</td>
                                    <td>
                                        @* Only for people who can be imported: for anyone else it isn't what they have, or will have, in Orbit. *@
                                        @if (!r.CanImport) { <text>-</text> }
                                        else if (r.IsLinked) { @r.DepartmentName }
                                        else { <span class="badge text-bg-warning" title="Choose a department for it above">Not linked</span> }
                                    </td>
                                    @if (p.ManagersRead)
                                    {
                                        var note = DirectoryImportRules.ManagerNote(r.Manager, r.CanImport);
                                        // For someone already in Orbit: the manager they have there, wherever it isn't the one named here.
                                        var inOrbit = r.ExistingUserId is Guid uid && changing.TryGetValue(uid, out var change) ? change.CurrentManagerName ?? "none"
                                            : r.Manager.Status != DirectoryManagerStatus.Resolved ? r.OrbitManagerName
                                            : null;
                                        <td>
                                            @(r.Manager.Name ?? "-")
                                            @if (note is not null) { <div class="small text-muted">@note</div> }
                                            @if (inOrbit is not null) { <div class="small text-muted">In Orbit: @inOrbit</div> }
                                        </td>
                                    }
                                    <td>
                                        @switch (r.Status)
                                        {
                                            case DirectoryImportStatus.Ready:
                                                <span class="badge text-bg-success">Ready</span>
                                                break;
                                            case DirectoryImportStatus.InOrbit:
                                                <a class="badge text-bg-secondary text-decoration-none" asp-page="/Admin/Users/Edit" asp-route-id="@r.ExistingUserId">Already in Orbit</a>
                                                break;
                                            default:
                                                <span class="badge text-bg-secondary">@DirectoryImportRules.StatusLabel(r.Status)</span>
                                                break;
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (p.Rows.Count == 0)
                {
                    <div class="p-3 text-muted">Nothing under the search base matches the filter.</div>
                }
            </div>
        </div>
    </form>
}

@functions {
    private static string People(int n) => n == 1 ? "1 person" : $"{n} people";
}

