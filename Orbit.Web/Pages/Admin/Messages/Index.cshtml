@page
@model Orbit.Pages.Admin.Messages.IndexModel
@using Orbit.Application.Messages
@{
    ViewData["Title"] = "Messages";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Messages</h1>
        <div class="text-muted small">
            The emails Orbit sends when something happens, each with whom it goes to and what it says. Nobody is emailed about what they
            did themselves, and someone a message would reach twice for one change gets only the most personal one.
        </div>
    </div>
    <div class="d-flex gap-2">
        <form method="post" asp-page-handler="TestEmail">
            <button type="submit" class="btn btn-outline-secondary btn-sm" title="Send a short email to your own address">Send test email</button>
        </form>
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Admin/Messages/Emails">Emails sent</a>
    </div>
</div>

@if (Model.OnlyLogged)
{
    <div class="alert alert-info small">
        No mail server is set up yet, so Orbit writes each email to its log instead of sending it.
        <a asp-page="/Admin/Messages/Emails">Emails sent</a> lists them as they would have gone.
    </div>
}
else
{
    <div class="text-muted small mb-3">
        Emails are sent through @Model.Email.Provider from @Model.Email.FromName &lt;@Model.Email.FromAddress&gt;.
    </div>
}

@foreach (var group in MessageCatalogue.Groups)
{
    <h2 class="h5 mt-4 mb-2">@group.Key</h2>
    @foreach (var trigger in group)
    {
        var items = Model.For(trigger.Trigger);
        <div class="card mb-3">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-start gap-2">
                <div>
                    <div class="fw-semibold">@trigger.Label</div>
                    <div class="small text-muted">@trigger.Description</div>
                </div>
                <a class="btn btn-outline-primary btn-sm text-nowrap" asp-page="/Admin/Messages/Edit" asp-route-trigger="@trigger.Trigger">Add a message</a>
            </div>
            @if (items.Count == 0)
            {
                <div class="card-body small text-muted fst-italic">No message: nobody is emailed.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <tbody>
                            @foreach (var m in items)
                            {
                                <tr class="@(m.Enabled ? null : "text-muted")">
                                    <td>
                                        <a asp-page="/Admin/Messages/Edit" asp-route-id="@m.Id" class="fw-semibold text-decoration-none">@m.Name</a>
                                        <div class="small text-muted">@Ui.Truncate(m.Subject, 100)</div>
                                    </td>
                                    <td class="small">
                                        To @string.Join(", ", m.Recipients.Select(r => r.Kind).Order().Select(k => k.Label().ToLowerInvariant())
                                            .Concat(MessageRules.ParseAddresses(m.Addresses).Addresses.Select(a => a.Address)))
                                        @if (m.Condition != MessageCondition.Always) { <div class="text-muted">@m.Condition.Label()</div> }
                                    </td>
                                    <td class="d-none d-md-table-cell small text-muted text-nowrap">@(Model.Sent.GetValueOrDefault(m.Id)) in the outbox</td>
                                    <td class="text-end">
                                        <form method="post" asp-page-handler="Enabled" asp-route-id="@m.Id" asp-route-enabled="@(!m.Enabled)">
                                            @if (m.Enabled)
                                            {
                                                <button type="submit" class="btn btn-success btn-sm" title="Switch it off">On</button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="Switch it on">Off</button>
                                            }
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
}
