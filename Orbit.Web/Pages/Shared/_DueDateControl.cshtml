@model DueDateControlVm
@* The inline due-date control (spec §6.2). js-autosubmit-delayed posts once typing pauses (site.js), so keyboard entry isn't cut
   off mid-date, and only when the value differs from data-original. Emptying it clears the due date. *@
@{
    var t = Model.Task;
    var overdue = t.IsOverdue(Model.Today);
    var due = t.DueDate?.ToString("yyyy-MM-dd") ?? string.Empty;
}
<form method="post" asp-page="/Tasks/Quick" asp-page-handler="DueDate" asp-route-id="@t.Id" asp-route-returnUrl="@Model.ReturnUrl" class="@Model.FormClass">
    <input type="date" name="dueDate" value="@due" data-original="@due" class="form-control form-control-sm @Model.InputClass js-autosubmit-delayed @(overdue ? "border-danger text-danger" : "")" aria-label="@Model.Label" title="@(overdue ? "Overdue" : Model.Label)" />
</form>
