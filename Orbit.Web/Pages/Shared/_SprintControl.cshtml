@model SprintControlVm
@* The inline sprint control (spec §6.2, §6.3): picking a sprint plans the task into it, Backlog takes it out of its sprint. Only
   the planned and active sprints are offered; a reopened task still in a completed one shows that sprint until it is moved. *@
@{
    var t = Model.Task;
}
<form method="post" asp-page="/Tasks/Quick" asp-page-handler="Sprint" asp-route-id="@t.Id" asp-route-returnUrl="@Model.ReturnUrl" class="@Model.FormClass" data-keep-place>
    <select name="sprintId" class="form-select form-select-sm @Model.SelectClass js-autosubmit" aria-label="@Model.Label">
        <option value="" selected="@(t.SprintId is null)">Backlog</option>
        @if (t.Sprint is not null && Model.Sprints.All(s => s.Id != t.SprintId))
        {
            <option value="@t.SprintId" selected>@t.Sprint.Name (@t.Sprint.Status)</option>
        }
        @foreach (var s in Model.Sprints)
        {
            <option value="@s.Id" selected="@(s.Id == t.SprintId)">@s.Name (@s.Status)</option>
        }
    </select>
</form>
